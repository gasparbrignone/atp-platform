dist/
# generated types
.astro/
# generado en build/dev por scripts/generate-upload-thumbnails.mjs, no
# contenido fuente — se recrea solo al correr npm run dev/build
public/uploads/thumbs/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# fotos sin editar/elegir todavía, esperando revisión — no son assets del
# sitio (eso vive en src/assets/), solo material crudo para elegir de ahí
raw-photos/

# exports personales de Google Search Console (CSVs/zips descargados para
# revisión manual) — no son parte del sitio ni de su documentación
/google/
docs/*Coverage-Validation*.zip

# salida local de scripts/add-library-promo-page.mjs (--preview /
# --test-one / --all / --upload) — PDFs de prueba y del batch de los 69
# libros + su resumen, nunca contenido versionado del sitio
.tmp-*.pdf
.tmp-batch-results.json
