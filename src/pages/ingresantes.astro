  del resto donde un botón flotante permanente sería puro ruido visual.
  Mismo número real que KeychainSaleSection.astro/AgendaSaleSection.astro.
*/}
<a
  href={WHATSAPP_URL}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escribir a ATP por WhatsApp"
  class="ease-standard fixed right-4 bottom-4 z-40 flex size-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg transition-transform duration-150 hover:scale-105 sm:right-6 sm:bottom-6"
>
  <svg viewBox="0 0 24 24" fill="currentColor" class="size-7" aria-hidden="true">
    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.29-1.39a9.9 9.9 0 0 0 4.75 1.21h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2Zm5.8 14.02c-.24.68-1.4 1.32-1.93 1.4-.5.08-1.12.11-1.81-.11-.42-.13-.95-.31-1.64-.6-2.88-1.24-4.76-4.13-4.9-4.32-.14-.19-1.17-1.56-1.17-2.98 0-1.42.74-2.11 1-2.4.26-.29.57-.36.76-.36.19 0 .38 0 .55.01.18.01.41-.07.64.49.24.58.81 2 .88 2.15.07.15.12.32.02.51-.1.19-.15.31-.29.48-.15.17-.31.38-.44.51-.15.15-.3.31-.13.6.17.29.76 1.25 1.63 2.02 1.12 1 2.06 1.31 2.35 1.46.29.15.46.13.63-.05.17-.19.72-.84.92-1.13.19-.29.38-.24.64-.15.26.1 1.65.78 1.94.92.29.15.48.22.55.34.07.13.07.72-.17 1.4Z"
    ></path>
  </svg>
</a>

<script>
  // Tabs de "Documentación" (Argentina / Extranjero) — mismo patrón vanilla
  // que los submenús de Navbar.astro: sin librería, toggle de `hidden` +
  // `aria-selected`.
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('[data-doc-tab]');
  const panels = document.querySelectorAll<HTMLElement>('[data-doc-panel]');

  function selectTab(target: string) {
    tabButtons.forEach((btn) => {
      const isActive = btn.dataset.docTab === target;
      btn.setAttribute('aria-selected', String(isActive));
      btn.classList.toggle('bg-primary-fill', isActive);
      btn.classList.toggle('text-primary-fill-foreground', isActive);
      btn.classList.toggle('text-text-secondary', !isActive);
    });
    panels.forEach((panel) => {
      panel.hidden = panel.dataset.docPanel !== target;
    });
  }

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => selectTab(btn.dataset.docTab ?? 'ar'));
  });
  selectTab('ar');

  // Checklist de documentación: pura conveniencia de quien visita (no hay
  // backend, no hace falta) — recuerda en este mismo navegador qué ítems ya
  // tildó, por tab, para que si vuelve más tarde no arranque de cero.
  const STORAGE_KEY = 'atp-ingresantes-checklist';

  function readChecked(): Record<string, boolean> {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEY) ?? '{}');
    } catch {
      return {};
    }
  }

  function writeChecked(state: Record<string, boolean>) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    } catch {
      // localStorage puede fallar (modo privado, storage lleno, etc.) — la
      // página sigue funcionando igual, solo no recuerda entre visitas.
    }
  }

  const checked = readChecked();
  const checkboxes = document.querySelectorAll<HTMLInputElement>('[data-doc-check]');

  function applyRowState(checkbox: HTMLInputElement) {
    const row = checkbox.closest('[data-doc-row]');
    row?.classList.toggle('opacity-60', checkbox.checked);
    const title = row?.querySelector<HTMLElement>('[data-doc-title]');
    title?.classList.toggle('line-through', checkbox.checked);
  }

  checkboxes.forEach((checkbox) => {
    const id = checkbox.dataset.docCheck;
    if (id && checked[id]) checkbox.checked = true;
    applyRowState(checkbox);

    checkbox.addEventListener('change', () => {
      if (id) checked[id] = checkbox.checked;
      writeChecked(checked);
      applyRowState(checkbox);
    });
  });
</script>
