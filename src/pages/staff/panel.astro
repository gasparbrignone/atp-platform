---
/**
 * Panel interno de administración: ver quiénes se inscribieron a una
 * actividad y mandarles una campaña de mail personalizada (etiquetas
 * {{nombre}}, {{apellido}}, {{email}}). Herramienta interna del staff, no una
 * página del sitio — sin Navbar/Footer, noindex (mismo criterio que
 * public/admin/index.html y src/pages/staff/escanear.astro).
 *
 * Login con contraseña + código de Google Authenticator (TOTP, RFC 6238),
 * verificado del lado del servidor en el Apps Script — ver
 * docs/GOOGLE_SHEETS_FORM_SETUP.md, sección "PANEL ADMIN". Nunca hay nada
 * sensible en este archivo: ni la contraseña, ni el secreto TOTP, ni el
 * token de sesión (ese vive solo en sessionStorage del navegador, y en el
 * cache del script del lado del servidor).
 */
import '@/styles/global.css';
import Button from '@/components/Button.astro';
import Input from '@/components/Input.astro';
import Select from '@/components/Select.astro';
import Checkbox from '@/components/Checkbox.astro';
import CampaignEditor from '@/components/CampaignEditor.tsx';
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import Lock from '@lucide/astro/icons/lock';
import Users from '@lucide/astro/icons/users';
import Send from '@lucide/astro/icons/send';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Panel admin — ATP</title>
  </head>
  <body class="bg-background text-text min-h-screen">
    <div class="mx-auto flex min-h-screen w-full max-w-5xl flex-col gap-8 p-4 sm:p-6 lg:p-10">
      <div class="flex flex-col gap-3">
        <a
          href="/staff/"
          class="text-body-sm text-secondary-strong inline-flex w-fit items-center gap-1.5 font-semibold underline-offset-2 hover:underline"
        >
          <ArrowLeft class="size-4" aria-hidden="true" />
          Herramientas de staff
        </a>
        <div class="flex items-center gap-3">
          <div
            class="bg-secondary/10 text-secondary-strong inline-flex size-11 shrink-0 items-center justify-center rounded-full"
          >
            <Lock class="size-5" aria-hidden="true" />
          </div>
          <div>
            <h1 class="text-h3 text-text font-extrabold">Panel admin</h1>
            <p class="text-body-sm text-text-secondary">
              Inscriptos por actividad y campañas de mail
            </p>
          </div>
        </div>
      </div>

      <form
        data-login-form
        class="border-border bg-surface mx-auto flex w-full max-w-md flex-col gap-4 rounded-md border p-6"
      >
        <div class="flex flex-col gap-2">
          <label for="admin-password" class="text-caption text-text-secondary font-semibold">
            Contraseña
          </label>
          <Input id="admin-password" type="password" autocomplete="off" required />
        </div>
        <div class="flex flex-col gap-2">
          <label for="admin-code" class="text-caption text-text-secondary font-semibold">
            Código de Google Authenticator
          </label>
          <Input
            id="admin-code"
            inputmode="numeric"
            pattern="\d{6}"
            maxlength="6"
            autocomplete="off"
            placeholder="123456"
            required
          />
        </div>
        <p data-login-error hidden class="text-caption text-error"></p>
        <Button type="submit" size="lg" data-login-submit class="self-start">Entrar</Button>
      </form>

      <div data-dashboard hidden class="flex flex-col gap-6">
        <div
          class="border-border bg-surface flex items-center justify-between rounded-md border p-4"
        >
          <p class="text-body-sm text-text-secondary">Sesión iniciada</p>
          <button
            type="button"
            data-logout-button
            class="text-body-sm text-secondary-strong font-semibold underline underline-offset-2"
          >
            Cerrar sesión
          </button>
        </div>

        <div class="flex flex-col items-start gap-6 lg:flex-row">
          <div
            class="border-border bg-surface flex w-full flex-col gap-4 rounded-md border p-6 lg:flex-1"
          >
            <div class="flex items-center gap-3">
              <Users class="text-secondary-strong size-6 shrink-0" aria-hidden="true" />
              <div>
                <p class="text-body font-bold">Inscriptos</p>
                <p class="text-caption text-text-secondary">
                  Elegí una actividad para ver quién se anotó. "Excluir" saca a esa persona solo de
                  la próxima campaña que mandes, no la da de baja de verdad.
                </p>
              </div>
            </div>

            <Select id="admin-activity" data-activity-select aria-label="Actividad">
              <option value="" selected disabled>Cargando actividades…</option>
            </Select>

            <div class="border-border overflow-x-auto rounded-md border">
              <table class="text-body-sm w-full">
                <thead class="bg-surface-alt text-left">
                  <tr>
                    <th class="p-3">Nombre</th>
                    <th class="p-3">Email</th>
                    <th class="p-3">Estado</th>
                    <th class="p-3">
                      <label class="flex items-center gap-1.5">
                        <input
                          type="checkbox"
                          data-exclude-all
                          class="border-border-strong accent-secondary-strong size-4 shrink-0 rounded-xs border"
                          aria-label="Excluir a todos los inscriptos de esta actividad"
                        />
                        Excluir
                      </label>
                    </th>
                  </tr>
                </thead>
                <tbody data-registrations-body>
                  <tr
                    ><td class="text-text-secondary p-3 text-center" colspan="4"
                      >Elegí una actividad.</td
                    ></tr
                  >
                </tbody>
              </table>
            </div>
          </div>

          <form
            data-campaign-form
            class="border-border bg-surface flex w-full flex-col gap-4 rounded-md border p-6 lg:flex-1"
          >
            <div class="flex items-center gap-3">
              <Send class="text-secondary-strong size-6 shrink-0" aria-hidden="true" />
              <div>
                <p class="text-body font-bold">Mandar campaña</p>
                <p class="text-caption text-text-secondary">
                  Etiquetas: <code>{'{{nombre}}'}</code>, <code>{'{{apellido}}'}</code>,{' '}
                  <code>{'{{email}}'}</code> — se manda solo a quienes no se dieron de baja.
                </p>
              </div>
            </div>

            <div class="flex flex-col gap-2">
              <label for="campaign-subject" class="text-caption text-text-secondary font-semibold">
                Asunto
              </label>
              <Input id="campaign-subject" data-campaign-subject required />
            </div>

            <div class="flex flex-col gap-2">
              <p class="text-caption text-text-secondary font-semibold">Mensaje</p>
              <CampaignEditor client:load />
            </div>

            <Checkbox
              id="campaign-include-reminder"
              data-campaign-reminder
              label="Incluir recordatorio de fecha y hora de la próxima clase"
            />

            <div
              class="border-border-strong bg-surface-alt flex flex-col gap-3 rounded-md border p-4"
            >
              <p class="text-caption text-text-secondary font-semibold">
                Agregar destinatarios manuales — además de los inscriptos de la actividad, solo para
                este envío (por ejemplo, para mandarte una prueba a vos mismo)
              </p>
              <div class="flex flex-col gap-2 sm:flex-row">
                <Input
                  id="manual-recipient-name"
                  data-manual-recipient-name
                  placeholder="Nombre"
                  aria-label="Nombre del destinatario manual"
                  class="sm:flex-1"
                />
                <Input
                  id="manual-recipient-email"
                  data-manual-recipient-email
                  type="email"
                  placeholder="Email"
                  aria-label="Email del destinatario manual"
                  class="sm:flex-1"
                />
                <Button
                  type="button"
                  variant="secondary"
                  data-manual-recipient-add
                  class="shrink-0"
                >
                  Agregar
                </Button>
              </div>
              <ul data-manual-recipient-list class="flex flex-wrap gap-2"></ul>
            </div>

            <Button
              type="button"
              size="lg"
              variant="secondary"
              data-preview-button
              class="self-start"
            >
              Ver vista previa
            </Button>

            <div
              data-preview-panel
              hidden
              class="border-border-strong bg-surface-alt flex flex-col gap-3 rounded-md border p-4"
            >
              <p class="text-caption text-text-secondary font-semibold">
                Así le va a llegar a <span data-preview-recipient class="text-text"></span>:
              </p>
              <!--
                El contenido de acá adentro es HTML de mail (wrapEmailHtml del
                Apps Script, con sus propios colores fijos pensados para
                fondo blanco de un cliente de mail) — va en un <iframe> con
                `srcdoc`, no inyectado directo en la página: así queda
                aislado del CSS y del tema (claro/oscuro) del sitio, y de
                cualquier "modo oscuro forzado" del navegador — se ve
                siempre exactamente como wrapEmailHtml lo armó, igual que en
                un cliente de mail real.
              -->
              <div class="border-border overflow-hidden rounded-xs border">
                <div class="bg-white px-4 py-3">
                  <p class="text-caption font-semibold text-[#6b7280]">Asunto</p>
                  <p data-preview-subject class="text-body font-semibold text-[#111827]"></p>
                </div>
                <iframe
                  data-preview-body
                  title="Vista previa del mail"
                  sandbox="allow-same-origin"
                  class="block w-full border-0"></iframe>
              </div>
            </div>

            <Button type="submit" size="lg" data-campaign-submit disabled class="self-start">
              Pedí una vista previa primero
            </Button>
          </form>
        </div>
      </div>
    </div>

    <script>
      import { jsonpRequest } from '@/lib/jsonp';
      import { GOOGLE_FORMS_ENDPOINT } from '@/lib/googleFormsEndpoint';
      import { showToast } from '@/lib/toast';

      const SESSION_KEY = 'atp-admin-token';

      interface Activity {
        sheetName: string;
        total: number;
        active: number;
      }

      interface Registration {
        nombre: string;
        email: string;
        dadoDeBaja: boolean;
      }

      interface CampaignPreview {
        result: string;
        subject?: string;
        bodyHtml?: string;
        sampleName?: string;
        activeCount?: number;
      }

      const loginForm = document.querySelector<HTMLFormElement>('[data-login-form]');
      const loginSubmit = document.querySelector<HTMLButtonElement>('[data-login-submit]');
      const loginError = document.querySelector<HTMLElement>('[data-login-error]');
      const passwordInput = document.querySelector<HTMLInputElement>('#admin-password');
      const codeInput = document.querySelector<HTMLInputElement>('#admin-code');

      const dashboard = document.querySelector<HTMLElement>('[data-dashboard]');
      const logoutButton = document.querySelector<HTMLButtonElement>('[data-logout-button]');
      const activitySelect = document.querySelector<HTMLSelectElement>('[data-activity-select]');
      const registrationsBody = document.querySelector<HTMLElement>('[data-registrations-body]');
      const excludeAllCheckbox = document.querySelector<HTMLInputElement>('[data-exclude-all]');

      const campaignForm = document.querySelector<HTMLFormElement>('[data-campaign-form]');
      const campaignSubject = document.querySelector<HTMLInputElement>('[data-campaign-subject]');
      // El <textarea> plano de siempre se reemplazó por CampaignEditor.tsx
      // (negrita/itálica/link/imagen) — sigue siendo un <input type="hidden">
      // con el mismo atributo data-campaign-body, así que todo lo de abajo
      // (invalidatePreview, el fetch de stage) no necesitó cambiar.
      const campaignBody = document.querySelector<HTMLInputElement>('[data-campaign-body]');
      const campaignReminder = document.querySelector<HTMLInputElement>('[data-campaign-reminder]');
      const campaignSubmit = document.querySelector<HTMLButtonElement>('[data-campaign-submit]');
      const manualRecipientName = document.querySelector<HTMLInputElement>(
        '[data-manual-recipient-name]',
      );
      const manualRecipientEmail = document.querySelector<HTMLInputElement>(
        '[data-manual-recipient-email]',
      );
      const manualRecipientAdd = document.querySelector<HTMLButtonElement>(
        '[data-manual-recipient-add]',
      );
      const manualRecipientList = document.querySelector<HTMLElement>(
        '[data-manual-recipient-list]',
      );
      const previewButton = document.querySelector<HTMLButtonElement>('[data-preview-button]');
      const previewPanel = document.querySelector<HTMLElement>('[data-preview-panel]');
      const previewRecipient = document.querySelector<HTMLElement>('[data-preview-recipient]');
      const previewSubject = document.querySelector<HTMLElement>('[data-preview-subject]');
      const previewBody = document.querySelector<HTMLIFrameElement>('[data-preview-body]');

      // Con sandbox="allow-same-origin" (sin allow-scripts) el iframe no
      // puede ejecutar JS del mail, pero sí se puede leer su altura real
      // para que no quede ni cortado ni con espacio de sobra debajo.
      if (previewBody) {
        previewBody.addEventListener('load', () => {
          try {
            const doc = previewBody.contentDocument;
            if (doc) previewBody.style.height = doc.documentElement.scrollHeight + 'px';
          } catch {
            previewBody.style.height = '480px';
          }
        });
      }

      // La vista previa "gatea" el envío: solo se puede mandar una
      // campaña cuyo texto exacto ya se vio armado con un destinatario
      // real. Cualquier cambio en actividad/asunto/mensaje después de
      // pedir la vista previa invalida esto — obliga a pedir una nueva
      // antes de poder mandar, así nunca se manda algo distinto de lo que
      // se vio en pantalla.
      let stagedCampaignId: string | null = null;
      let previewActiveCount = 0;

      // Destinatarios de esta campaña puntual, aparte de la hoja elegida —
      // nunca se guardan en ninguna planilla, solo viven en esta pestaña
      // mientras se arma el envío (ver Fase 5 del plan del panel admin).
      let extraRecipients: { nombre: string; email: string }[] = [];
      const excludedEmails = new Set<string>();

      function getToken(): string | null {
        return sessionStorage.getItem(SESSION_KEY);
      }

      function renderManualRecipients() {
        if (!manualRecipientList) return;
        manualRecipientList.innerHTML = '';
        extraRecipients.forEach((recipient, index) => {
          const item = document.createElement('li');
          item.className =
            'bg-surface border-border-strong text-caption inline-flex items-center gap-2 rounded-full border py-1 pr-1 pl-3';

          const label = document.createElement('span');
          label.textContent = recipient.nombre
            ? `${recipient.nombre} <${recipient.email}>`
            : recipient.email;
          item.appendChild(label);

          const removeButton = document.createElement('button');
          removeButton.type = 'button';
          removeButton.setAttribute('aria-label', `Sacar a ${recipient.email}`);
          removeButton.className =
            'text-text-secondary hover:bg-surface-alt hover:text-text inline-flex size-5 shrink-0 items-center justify-center rounded-full';
          removeButton.textContent = '×';
          removeButton.addEventListener('click', () => {
            extraRecipients.splice(index, 1);
            renderManualRecipients();
            invalidatePreview();
          });
          item.appendChild(removeButton);

          manualRecipientList.appendChild(item);
        });
      }

      // "Excluir" del header: prende/apaga todos los checkboxes de la tabla
      // a la vez — pensado para el caso de mandarse una prueba a uno mismo
      // (excluir a todos los inscriptos reales de una actividad real) sin
      // tener que tildar uno por uno si la lista es larga.
      function syncExcludeAllCheckbox() {
        if (!excludeAllCheckbox || !registrationsBody) return;
        const checkboxes =
          registrationsBody.querySelectorAll<HTMLInputElement>('[data-exclude-checkbox]');
        if (checkboxes.length === 0) {
          excludeAllCheckbox.checked = false;
          excludeAllCheckbox.indeterminate = false;
          return;
        }
        const checkedCount = Array.from(checkboxes).filter((cb) => cb.checked).length;
        excludeAllCheckbox.checked = checkedCount === checkboxes.length;
        excludeAllCheckbox.indeterminate = checkedCount > 0 && checkedCount < checkboxes.length;
      }

      excludeAllCheckbox?.addEventListener('change', () => {
        if (!registrationsBody) return;
        // Capturado ANTES del loop a propósito: cada dispatchEvent de
        // abajo corre el listener de esa fila, que llama a
        // syncExcludeAllCheckbox() y reescribe excludeAllCheckbox.checked
        // — leerlo de nuevo en cada vuelta terminaba usando ese valor ya
        // pisado, y solo la primera fila quedaba tildada de verdad.
        const shouldExclude = excludeAllCheckbox.checked;
        const checkboxes =
          registrationsBody.querySelectorAll<HTMLInputElement>('[data-exclude-checkbox]');
        checkboxes.forEach((checkbox) => {
          checkbox.checked = shouldExclude;
          checkbox.dispatchEvent(new Event('change'));
        });
      });

      manualRecipientAdd?.addEventListener('click', () => {
        const nombre = manualRecipientName?.value.trim() ?? '';
        const email = manualRecipientEmail?.value.trim() ?? '';

        // El nombre es obligatorio acá (a diferencia de la hoja, donde ya
        // viene cargado solo): sin nombre, "Hola <nombre>!" en el mail
        // muestra la etiqueta literal en vez del saludo — ya pasó dos
        // veces en producción, mejor prevenirlo que confiar en el aviso.
        if (!nombre) {
          showToast({
            message:
              'Escribí también el nombre — sin eso, el mail va a decir "Hola <nombre>!" literal.',
            variant: 'info',
          });
          return;
        }

        if (!email || !email.includes('@')) {
          showToast({ message: 'Escribí un email válido para agregarlo.', variant: 'info' });
          return;
        }

        extraRecipients.push({ nombre, email });
        if (manualRecipientName) manualRecipientName.value = '';
        if (manualRecipientEmail) manualRecipientEmail.value = '';
        renderManualRecipients();
        invalidatePreview();
      });

      function invalidatePreview() {
        stagedCampaignId = null;
        previewActiveCount = 0;
        if (previewPanel) previewPanel.hidden = true;
        if (previewBody) previewBody.srcdoc = '';
        if (campaignSubmit) {
          campaignSubmit.disabled = true;
          campaignSubmit.textContent = 'Pedí una vista previa primero';
        }
      }

      function handleSessionExpired() {
        sessionStorage.removeItem(SESSION_KEY);
        if (dashboard) dashboard.hidden = true;
        if (loginForm) loginForm.hidden = false;
        showToast({ message: 'Tu sesión venció — iniciá sesión de nuevo.', variant: 'info' });
      }

      async function loadActivities() {
        const token = getToken();
        if (!token || !activitySelect) return;

        try {
          const response = await jsonpRequest<{ result: string; activities?: Activity[] }>(
            GOOGLE_FORMS_ENDPOINT,
            { action: 'adminListActivities', token },
          );
          if (response.result === 'unauthorized') return handleSessionExpired();

          activitySelect.innerHTML = '';
          const placeholder = document.createElement('option');
          placeholder.value = '';
          placeholder.disabled = true;
          placeholder.selected = true;
          placeholder.textContent = 'Elegí una actividad';
          activitySelect.appendChild(placeholder);

          (response.activities ?? []).forEach((activity) => {
            const option = document.createElement('option');
            option.value = activity.sheetName;
            option.textContent = `${activity.sheetName} (${activity.active} activos de ${activity.total})`;
            activitySelect.appendChild(option);
          });
        } catch {
          showToast({
            message: 'No pudimos cargar las actividades. Probá de nuevo.',
            variant: 'error',
          });
        }
      }

      async function loadRegistrations(sheetName: string) {
        const token = getToken();
        if (!token || !registrationsBody) return;
        registrationsBody.innerHTML =
          '<tr><td class="p-3 text-text-secondary" colspan="4">Cargando…</td></tr>';

        try {
          const response = await jsonpRequest<{
            result: string;
            registrations?: Registration[];
          }>(GOOGLE_FORMS_ENDPOINT, { action: 'adminListRegistrations', token, sheetName });

          if (response.result === 'unauthorized') return handleSessionExpired();

          if (response.result !== 'success' || !response.registrations) {
            registrationsBody.innerHTML =
              '<tr><td class="p-3 text-text-secondary" colspan="4">No se encontró la hoja.</td></tr>';
            return;
          }

          registrationsBody.innerHTML = '';
          response.registrations.forEach((registration) => {
            const row = document.createElement('tr');
            row.className = 'border-border border-t';

            const nameCell = document.createElement('td');
            nameCell.className = 'p-3';
            nameCell.textContent = registration.nombre;

            const emailCell = document.createElement('td');
            emailCell.className = 'p-3';
            emailCell.textContent = registration.email;

            const statusCell = document.createElement('td');
            statusCell.className = 'p-3';
            const statusBadge = document.createElement('span');
            // Mismas clases que Badge.astro (variant success/neutral) — no
            // se puede usar el componente Astro acá porque esto es DOM
            // armado a mano en el navegador, pero la paleta tiene que ser
            // la misma, no una inventada para esta pantalla nada más.
            statusBadge.className = registration.dadoDeBaja
              ? 'text-caption inline-flex items-center gap-1 rounded-full px-3 py-1 font-semibold bg-gray-100 text-gray-700'
              : 'text-caption inline-flex items-center gap-1 rounded-full px-3 py-1 font-semibold bg-success text-success-foreground';
            statusBadge.textContent = registration.dadoDeBaja ? 'Dado de baja' : 'Activo';
            statusCell.appendChild(statusBadge);

            const excludeCell = document.createElement('td');
            excludeCell.className = 'p-3';
            const excludeCheckbox = document.createElement('input');
            excludeCheckbox.type = 'checkbox';
            // Mismas clases que Checkbox.astro — armado a mano acá porque
            // esta tabla es DOM creado en el navegador, no markup de Astro.
            excludeCheckbox.className =
              'border-border-strong accent-secondary-strong size-4 shrink-0 rounded-xs border';
            excludeCheckbox.setAttribute('data-exclude-checkbox', '');
            excludeCheckbox.setAttribute(
              'aria-label',
              `Excluir a ${registration.email} de la próxima campaña`,
            );
            excludeCheckbox.addEventListener('change', () => {
              const email = registration.email.toLowerCase();
              if (excludeCheckbox.checked) excludedEmails.add(email);
              else excludedEmails.delete(email);
              syncExcludeAllCheckbox();
              invalidatePreview();
            });
            excludeCell.appendChild(excludeCheckbox);

            row.append(nameCell, emailCell, statusCell, excludeCell);
            registrationsBody.appendChild(row);
          });
          if (excludeAllCheckbox) {
            excludeAllCheckbox.checked = false;
            excludeAllCheckbox.indeterminate = false;
          }
        } catch {
          registrationsBody.innerHTML =
            '<tr><td class="p-3 text-text-secondary" colspan="4">Error al cargar.</td></tr>';
        }
      }

      function showDashboard() {
        if (loginForm) loginForm.hidden = true;
        if (dashboard) dashboard.hidden = false;
        void loadActivities();
      }

      if (getToken()) showDashboard();

      loginForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!loginSubmit || loginSubmit.disabled) return;

        const password = passwordInput?.value ?? '';
        const code = codeInput?.value ?? '';
        if (!password || !/^\d{6}$/.test(code)) {
          if (loginError) {
            loginError.textContent = 'Completá la contraseña y el código de 6 dígitos.';
            loginError.hidden = false;
          }
          return;
        }

        loginSubmit.disabled = true;
        try {
          const loginId = crypto.randomUUID();
          // La contraseña y el código van solo acá, en el body de un POST
          // — nunca en una URL. No se puede leer la respuesta de este
          // pedido (Apps Script no manda headers CORS), así que el
          // resultado real se retira aparte con adminLoginPoll
          // (GET/JSONP, sin la contraseña ni el código, solo este loginId
          // de un solo uso que no vale nada por sí mismo).
          await fetch(GOOGLE_FORMS_ENDPOINT, {
            method: 'POST',
            mode: 'no-cors',
            body: new URLSearchParams({ action: 'adminLoginAttempt', password, code, loginId }),
          });

          const response = await jsonpRequest<{ result: string; token?: string }>(
            GOOGLE_FORMS_ENDPOINT,
            {
              action: 'adminLoginPoll',
              loginId,
            },
          );

          if (response.result === 'success' && response.token) {
            sessionStorage.setItem(SESSION_KEY, response.token);
            if (loginError) loginError.hidden = true;
            if (codeInput) codeInput.value = '';
            if (passwordInput) passwordInput.value = '';
            showDashboard();
          } else if (loginError) {
            loginError.textContent = 'Contraseña o código incorrectos.';
            loginError.hidden = false;
          }
        } catch {
          if (loginError) {
            loginError.textContent = 'No pudimos conectar. Probá de nuevo en un rato.';
            loginError.hidden = false;
          }
        } finally {
          loginSubmit.disabled = false;
        }
      });

      logoutButton?.addEventListener('click', () => {
        const token = getToken();
        sessionStorage.removeItem(SESSION_KEY);
        if (token)
          void jsonpRequest(GOOGLE_FORMS_ENDPOINT, { action: 'adminLogout', token }).catch(
            () => {},
          );
        if (dashboard) dashboard.hidden = true;
        if (loginForm) loginForm.hidden = false;
      });

      activitySelect?.addEventListener('change', () => {
        invalidatePreview();
        // Las exclusiones son por fila de ESTA actividad — al cambiar de
        // actividad la tabla se vuelve a armar de cero, así que las
        // exclusiones viejas ya no tienen sentido. Los destinatarios
        // manuales, en cambio, no dependen de la hoja: se mantienen.
        excludedEmails.clear();
        if (activitySelect.value) void loadRegistrations(activitySelect.value);
      });

      campaignSubject?.addEventListener('input', invalidatePreview);
      campaignBody?.addEventListener('input', invalidatePreview);
      campaignReminder?.addEventListener('change', invalidatePreview);

      previewButton?.addEventListener('click', async () => {
        const token = getToken();
        const sheetName = activitySelect?.value;
        const subject = campaignSubject?.value.trim();
        const body = campaignBody?.value.trim();

        if (!token || !sheetName || !subject || !body) {
          showToast({
            message: 'Completá actividad, asunto y mensaje antes de pedir la vista previa.',
            variant: 'info',
          });
          return;
        }

        if (!previewButton) return;
        previewButton.disabled = true;
        invalidatePreview();

        const campaignId = crypto.randomUUID();
        try {
          // Igual que el envío real: primero se guarda por POST (el
          // mensaje puede ser más largo de lo que entra en una URL),
          // después se lee por JSONP — acá solo para previsualizar, sin
          // gastar el envío real (adminPreviewCampaign no borra el cache).
          await fetch(GOOGLE_FORMS_ENDPOINT, {
            method: 'POST',
            mode: 'no-cors',
            body: new URLSearchParams({
              action: 'adminStageCampaign',
              token,
              campaignId,
              sheetName,
              subject,
              body,
              includeSessionReminder: String(campaignReminder?.checked ?? false),
              extraRecipients: JSON.stringify(extraRecipients),
              excludedEmails: JSON.stringify([...excludedEmails]),
            }),
          });

          const response = await jsonpRequest<CampaignPreview>(GOOGLE_FORMS_ENDPOINT, {
            action: 'adminPreviewCampaign',
            token,
            campaignId,
          });

          if (response.result === 'unauthorized') return handleSessionExpired();

          if (response.result === 'no_recipients') {
            showToast({
              message:
                'No hay a quién mandarle nada: o esta actividad no tiene inscriptos activos, o excluiste a todos los que tenía y no agregaste ningún destinatario manual.',
              variant: 'error',
              duration: 9000,
            });
            return;
          }

          if (response.result !== 'success' || !response.bodyHtml) {
            showToast({
              message: 'No pudimos armar la vista previa. Probá de nuevo.',
              variant: 'error',
            });
            return;
          }

          stagedCampaignId = campaignId;
          previewActiveCount = response.activeCount ?? 0;

          if (previewRecipient) previewRecipient.textContent = response.sampleName ?? '';
          if (previewSubject) previewSubject.textContent = response.subject ?? '';
          if (previewBody) previewBody.srcdoc = response.bodyHtml;
          if (previewPanel) previewPanel.hidden = false;

          if (campaignSubmit) {
            campaignSubmit.disabled = false;
            campaignSubmit.textContent = `Confirmar envío a ${previewActiveCount} persona(s)`;
          }
        } catch {
          showToast({
            message: 'No pudimos armar la vista previa. Probá de nuevo.',
            variant: 'error',
          });
        } finally {
          previewButton.disabled = false;
        }
      });

      campaignForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const token = getToken();

        // El botón queda deshabilitado hasta tener una vista previa
        // vigente (ver invalidatePreview) — este chequeo es la última
        // barrera, no la única.
        if (!token || !stagedCampaignId) {
          showToast({ message: 'Pedí una vista previa antes de mandar.', variant: 'info' });
          return;
        }

        if (!campaignSubmit) return;
        campaignSubmit.disabled = true;
        const campaignId = stagedCampaignId;

        try {
          const response = await jsonpRequest<{ result: string; sent?: number; total?: number }>(
            GOOGLE_FORMS_ENDPOINT,
            { action: 'adminSendCampaign', token, campaignId },
          );

          if (response.result === 'unauthorized') return handleSessionExpired();

          if (response.result === 'success') {
            showToast({
              message: `Campaña enviada: ${response.sent} de ${response.total}.`,
              variant: 'success',
            });
            campaignForm.reset(); // dispara 'reset', que CampaignEditor escucha para vaciar el mensaje
            extraRecipients = [];
            excludedEmails.clear();
            renderManualRecipients();
            if (activitySelect?.value) void loadRegistrations(activitySelect.value);
            invalidatePreview();
          } else {
            // No reintentar solo: si el envío en sí ya salió y lo que se
            // perdió fue la respuesta (corte de red), reintentar acá
            // mandaría la campaña dos veces. La pestaña "Campañas
            // enviadas" de la planilla es la fuente real de si salió o no.
            showToast({
              message:
                'No pudimos confirmar el envío — antes de reintentar, revisá la pestaña "Campañas enviadas" de la planilla, puede que ya se haya mandado.',
              variant: 'error',
            });
            invalidatePreview();
          }
        } catch {
          showToast({
            message:
              'No pudimos confirmar el envío — antes de reintentar, revisá la pestaña "Campañas enviadas" de la planilla, puede que ya se haya mandado.',
            variant: 'error',
          });
          invalidatePreview();
        } finally {
          campaignSubmit.disabled = false;
        }
      });
    </script>
  </body>
</html>
