---
/**
 * Panel interno de administración: ver quiénes se inscribieron a una
 * actividad y mandarles una campaña de mail personalizada (etiquetas
 * <nombre>, <apellido>, <email>). Herramienta interna del staff, no una
 * página del sitio — sin Navbar/Footer, noindex (mismo criterio que
 * public/admin/index.html y src/pages/staff/escanear.astro).
 *
 * Login con contraseña + código de Google Authenticator (TOTP, RFC 6238),
 * verificado del lado del servidor en el Apps Script — ver
 * docs/GOOGLE_SHEETS_FORM_SETUP.md, sección "PANEL ADMIN". Nunca hay nada
 * sensible en este archivo: ni la contraseña, ni el secreto TOTP, ni el
 * token de sesión (ese vive solo en sessionStorage del navegador, y en el
 * cache del script del lado del servidor).
 */
import '@/styles/global.css';
import Button from '@/components/Button.astro';
import Input from '@/components/Input.astro';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Panel admin — ATP</title>
  </head>
  <body class="bg-background text-text min-h-screen">
    <div class="mx-auto flex min-h-screen w-full max-w-2xl flex-col gap-6 p-4 sm:p-6">
      <h1 class="text-h4 text-text pt-4 font-bold">Panel admin</h1>

      <form data-login-form class="border-border bg-surface flex flex-col gap-4 rounded-md border p-6">
        <div class="flex flex-col gap-2">
          <label for="admin-password" class="text-caption text-text-secondary font-semibold">
            Contraseña
          </label>
          <Input id="admin-password" type="password" autocomplete="off" required />
        </div>
        <div class="flex flex-col gap-2">
          <label for="admin-code" class="text-caption text-text-secondary font-semibold">
            Código de Google Authenticator
          </label>
          <Input
            id="admin-code"
            inputmode="numeric"
            pattern="\d{6}"
            maxlength="6"
            autocomplete="off"
            placeholder="123456"
            required
          />
        </div>
        <p data-login-error hidden class="text-caption text-error"></p>
        <Button type="submit" size="lg" data-login-submit class="self-start">Entrar</Button>
      </form>

      <div data-dashboard hidden class="flex flex-col gap-6">
        <div class="flex items-center justify-between">
          <p class="text-body-sm text-text-secondary">Sesión iniciada</p>
          <button
            type="button"
            data-logout-button
            class="text-body-sm text-secondary-strong font-semibold underline underline-offset-2"
          >
            Cerrar sesión
          </button>
        </div>

        <div class="flex flex-col gap-2">
          <label for="admin-activity" class="text-caption text-text-secondary font-semibold">
            Actividad
          </label>
          <select
            id="admin-activity"
            data-activity-select
            class="border-border-strong bg-surface text-body text-text focus:border-secondary-strong h-10 w-full rounded-xs border px-4"
          >
            <option value="" selected disabled>Cargando actividades…</option>
          </select>
        </div>

        <div class="flex flex-col gap-2">
          <p class="text-caption text-text-secondary font-semibold">Inscriptos</p>
          <div class="border-border overflow-x-auto rounded-md border">
            <table class="text-body-sm w-full">
              <thead class="bg-surface-alt text-left">
                <tr>
                  <th class="p-3">Nombre</th>
                  <th class="p-3">Email</th>
                  <th class="p-3">Estado</th>
                </tr>
              </thead>
              <tbody data-registrations-body>
                <tr><td class="text-text-secondary p-3" colspan="3">Elegí una actividad.</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <form data-campaign-form class="border-border bg-surface flex flex-col gap-4 rounded-md border p-6">
          <div class="flex flex-col gap-1">
            <p class="text-body font-bold">Mandar campaña</p>
            <p class="text-caption text-text-secondary">
              Etiquetas disponibles: <code>&lt;nombre&gt;</code>, <code>&lt;apellido&gt;</code>,{' '}
              <code>&lt;email&gt;</code> — se reemplazan por el dato real de cada persona. Se manda
              solo a quienes no se dieron de baja.
            </p>
          </div>

          <div class="flex flex-col gap-2">
            <label for="campaign-subject" class="text-caption text-text-secondary font-semibold">
              Asunto
            </label>
            <Input id="campaign-subject" data-campaign-subject required />
          </div>

          <div class="flex flex-col gap-2">
            <label for="campaign-body" class="text-caption text-text-secondary font-semibold">
              Mensaje
            </label>
            <textarea
              id="campaign-body"
              data-campaign-body
              rows="8"
              required
              class="border-border-strong bg-surface text-body text-text focus:border-secondary-strong w-full rounded-xs border px-4 py-2"
              placeholder={'Hola <nombre>, te escribimos para avisarte que...'}
            ></textarea>
          </div>

          <Button type="button" size="lg" variant="secondary" data-preview-button class="self-start">
            Ver vista previa
          </Button>

          <div
            data-preview-panel
            hidden
            class="border-border-strong bg-surface-alt flex flex-col gap-3 rounded-md border p-4"
          >
            <p class="text-caption text-text-secondary font-semibold">
              Así le va a llegar a <span data-preview-recipient class="text-text"></span>:
            </p>
            <div class="border-border rounded-xs border bg-white p-4">
              <p class="text-caption text-text-secondary font-semibold">Asunto</p>
              <p data-preview-subject class="text-body text-text mb-3"></p>
              <p class="text-caption text-text-secondary font-semibold">Mensaje</p>
              <div data-preview-body class="text-body text-text"></div>
            </div>
          </div>

          <Button type="submit" size="lg" data-campaign-submit disabled class="self-start">
            Pedí una vista previa primero
          </Button>
        </form>
      </div>
    </div>

    <script>
      import { jsonpRequest } from '@/lib/jsonp';
      import { GOOGLE_FORMS_ENDPOINT } from '@/lib/googleFormsEndpoint';
      import { showToast } from '@/lib/toast';

      const SESSION_KEY = 'atp-admin-token';

      interface Activity {
        sheetName: string;
        total: number;
        active: number;
      }

      interface Registration {
        nombre: string;
        email: string;
        dadoDeBaja: boolean;
      }

      interface CampaignPreview {
        result: string;
        subject?: string;
        bodyHtml?: string;
        sampleName?: string;
        activeCount?: number;
      }

      const loginForm = document.querySelector<HTMLFormElement>('[data-login-form]');
      const loginSubmit = document.querySelector<HTMLButtonElement>('[data-login-submit]');
      const loginError = document.querySelector<HTMLElement>('[data-login-error]');
      const passwordInput = document.querySelector<HTMLInputElement>('#admin-password');
      const codeInput = document.querySelector<HTMLInputElement>('#admin-code');

      const dashboard = document.querySelector<HTMLElement>('[data-dashboard]');
      const logoutButton = document.querySelector<HTMLButtonElement>('[data-logout-button]');
      const activitySelect = document.querySelector<HTMLSelectElement>('[data-activity-select]');
      const registrationsBody = document.querySelector<HTMLElement>('[data-registrations-body]');

      const campaignForm = document.querySelector<HTMLFormElement>('[data-campaign-form]');
      const campaignSubject = document.querySelector<HTMLInputElement>('[data-campaign-subject]');
      const campaignBody = document.querySelector<HTMLTextAreaElement>('[data-campaign-body]');
      const campaignSubmit = document.querySelector<HTMLButtonElement>('[data-campaign-submit]');
      const previewButton = document.querySelector<HTMLButtonElement>('[data-preview-button]');
      const previewPanel = document.querySelector<HTMLElement>('[data-preview-panel]');
      const previewRecipient = document.querySelector<HTMLElement>('[data-preview-recipient]');
      const previewSubject = document.querySelector<HTMLElement>('[data-preview-subject]');
      const previewBody = document.querySelector<HTMLElement>('[data-preview-body]');

      // La vista previa "gatea" el envío: solo se puede mandar una
      // campaña cuyo texto exacto ya se vio armado con un destinatario
      // real. Cualquier cambio en actividad/asunto/mensaje después de
      // pedir la vista previa invalida esto — obliga a pedir una nueva
      // antes de poder mandar, así nunca se manda algo distinto de lo que
      // se vio en pantalla.
      let stagedCampaignId: string | null = null;
      let previewActiveCount = 0;

      function getToken(): string | null {
        return sessionStorage.getItem(SESSION_KEY);
      }

      function invalidatePreview() {
        stagedCampaignId = null;
        previewActiveCount = 0;
        if (previewPanel) previewPanel.hidden = true;
        if (previewBody) previewBody.innerHTML = '';
        if (campaignSubmit) {
          campaignSubmit.disabled = true;
          campaignSubmit.textContent = 'Pedí una vista previa primero';
        }
      }

      function handleSessionExpired() {
        sessionStorage.removeItem(SESSION_KEY);
        if (dashboard) dashboard.hidden = true;
        if (loginForm) loginForm.hidden = false;
        showToast({ message: 'Tu sesión venció — iniciá sesión de nuevo.', variant: 'info' });
      }

      async function loadActivities() {
        const token = getToken();
        if (!token || !activitySelect) return;

        try {
          const response = await jsonpRequest<{ result: string; activities?: Activity[] }>(
            GOOGLE_FORMS_ENDPOINT,
            { action: 'adminListActivities', token },
          );
          if (response.result === 'unauthorized') return handleSessionExpired();

          activitySelect.innerHTML = '';
          const placeholder = document.createElement('option');
          placeholder.value = '';
          placeholder.disabled = true;
          placeholder.selected = true;
          placeholder.textContent = 'Elegí una actividad';
          activitySelect.appendChild(placeholder);

          (response.activities ?? []).forEach((activity) => {
            const option = document.createElement('option');
            option.value = activity.sheetName;
            option.textContent = `${activity.sheetName} (${activity.active} activos de ${activity.total})`;
            activitySelect.appendChild(option);
          });
        } catch {
          showToast({ message: 'No pudimos cargar las actividades. Probá de nuevo.', variant: 'error' });
        }
      }

      async function loadRegistrations(sheetName: string) {
        const token = getToken();
        if (!token || !registrationsBody) return;
        registrationsBody.innerHTML = '<tr><td class="p-3 text-text-secondary" colspan="3">Cargando…</td></tr>';

        try {
          const response = await jsonpRequest<{
            result: string;
            registrations?: Registration[];
          }>(GOOGLE_FORMS_ENDPOINT, { action: 'adminListRegistrations', token, sheetName });

          if (response.result === 'unauthorized') return handleSessionExpired();

          if (response.result !== 'success' || !response.registrations) {
            registrationsBody.innerHTML =
              '<tr><td class="p-3 text-text-secondary" colspan="3">No se encontró la hoja.</td></tr>';
            return;
          }

          registrationsBody.innerHTML = '';
          response.registrations.forEach((registration) => {
            const row = document.createElement('tr');
            row.className = 'border-border border-t';

            const nameCell = document.createElement('td');
            nameCell.className = 'p-3';
            nameCell.textContent = registration.nombre;

            const emailCell = document.createElement('td');
            emailCell.className = 'p-3';
            emailCell.textContent = registration.email;

            const statusCell = document.createElement('td');
            statusCell.className = 'p-3';
            statusCell.textContent = registration.dadoDeBaja ? 'Dado de baja' : 'Activo';

            row.append(nameCell, emailCell, statusCell);
            registrationsBody.appendChild(row);
          });
        } catch {
          registrationsBody.innerHTML =
            '<tr><td class="p-3 text-text-secondary" colspan="3">Error al cargar.</td></tr>';
        }
      }

      function showDashboard() {
        if (loginForm) loginForm.hidden = true;
        if (dashboard) dashboard.hidden = false;
        void loadActivities();
      }

      if (getToken()) showDashboard();

      loginForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!loginSubmit || loginSubmit.disabled) return;

        const password = passwordInput?.value ?? '';
        const code = codeInput?.value ?? '';
        if (!password || !/^\d{6}$/.test(code)) {
          if (loginError) {
            loginError.textContent = 'Completá la contraseña y el código de 6 dígitos.';
            loginError.hidden = false;
          }
          return;
        }

        loginSubmit.disabled = true;
        try {
          const loginId = crypto.randomUUID();
          // La contraseña y el código van solo acá, en el body de un POST
          // — nunca en una URL. No se puede leer la respuesta de este
          // pedido (Apps Script no manda headers CORS), así que el
          // resultado real se retira aparte con adminLoginPoll
          // (GET/JSONP, sin la contraseña ni el código, solo este loginId
          // de un solo uso que no vale nada por sí mismo).
          await fetch(GOOGLE_FORMS_ENDPOINT, {
            method: 'POST',
            mode: 'no-cors',
            body: new URLSearchParams({ action: 'adminLoginAttempt', password, code, loginId }),
          });

          const response = await jsonpRequest<{ result: string; token?: string }>(GOOGLE_FORMS_ENDPOINT, {
            action: 'adminLoginPoll',
            loginId,
          });

          if (response.result === 'success' && response.token) {
            sessionStorage.setItem(SESSION_KEY, response.token);
            if (loginError) loginError.hidden = true;
            if (codeInput) codeInput.value = '';
            if (passwordInput) passwordInput.value = '';
            showDashboard();
          } else if (loginError) {
            loginError.textContent = 'Contraseña o código incorrectos.';
            loginError.hidden = false;
          }
        } catch {
          if (loginError) {
            loginError.textContent = 'No pudimos conectar. Probá de nuevo en un rato.';
            loginError.hidden = false;
          }
        } finally {
          loginSubmit.disabled = false;
        }
      });

      logoutButton?.addEventListener('click', () => {
        const token = getToken();
        sessionStorage.removeItem(SESSION_KEY);
        if (token) void jsonpRequest(GOOGLE_FORMS_ENDPOINT, { action: 'adminLogout', token }).catch(() => {});
        if (dashboard) dashboard.hidden = true;
        if (loginForm) loginForm.hidden = false;
      });

      activitySelect?.addEventListener('change', () => {
        invalidatePreview();
        if (activitySelect.value) void loadRegistrations(activitySelect.value);
      });

      campaignSubject?.addEventListener('input', invalidatePreview);
      campaignBody?.addEventListener('input', invalidatePreview);

      previewButton?.addEventListener('click', async () => {
        const token = getToken();
        const sheetName = activitySelect?.value;
        const subject = campaignSubject?.value.trim();
        const body = campaignBody?.value.trim();

        if (!token || !sheetName || !subject || !body) {
          showToast({ message: 'Completá actividad, asunto y mensaje antes de pedir la vista previa.', variant: 'info' });
          return;
        }

        if (!previewButton) return;
        previewButton.disabled = true;
        invalidatePreview();

        const campaignId = crypto.randomUUID();
        try {
          // Igual que el envío real: primero se guarda por POST (el
          // mensaje puede ser más largo de lo que entra en una URL),
          // después se lee por JSONP — acá solo para previsualizar, sin
          // gastar el envío real (adminPreviewCampaign no borra el cache).
          await fetch(GOOGLE_FORMS_ENDPOINT, {
            method: 'POST',
            mode: 'no-cors',
            body: new URLSearchParams({ action: 'adminStageCampaign', token, campaignId, sheetName, subject, body }),
          });

          const response = await jsonpRequest<CampaignPreview>(GOOGLE_FORMS_ENDPOINT, {
            action: 'adminPreviewCampaign',
            token,
            campaignId,
          });

          if (response.result === 'unauthorized') return handleSessionExpired();

          if (response.result === 'no_recipients') {
            showToast({
              message: 'Esta actividad todavía no tiene inscriptos activos — no hay a quién mandarle nada.',
              variant: 'info',
            });
            return;
          }

          if (response.result !== 'success' || !response.bodyHtml) {
            showToast({ message: 'No pudimos armar la vista previa. Probá de nuevo.', variant: 'error' });
            return;
          }

          stagedCampaignId = campaignId;
          previewActiveCount = response.activeCount ?? 0;

          if (previewRecipient) previewRecipient.textContent = response.sampleName ?? '';
          if (previewSubject) previewSubject.textContent = response.subject ?? '';
          if (previewBody) previewBody.innerHTML = response.bodyHtml;
          if (previewPanel) previewPanel.hidden = false;

          if (campaignSubmit) {
            campaignSubmit.disabled = false;
            campaignSubmit.textContent = `Confirmar envío a ${previewActiveCount} persona(s)`;
          }
        } catch {
          showToast({ message: 'No pudimos armar la vista previa. Probá de nuevo.', variant: 'error' });
        } finally {
          previewButton.disabled = false;
        }
      });

      campaignForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const token = getToken();

        // El botón queda deshabilitado hasta tener una vista previa
        // vigente (ver invalidatePreview) — este chequeo es la última
        // barrera, no la única.
        if (!token || !stagedCampaignId) {
          showToast({ message: 'Pedí una vista previa antes de mandar.', variant: 'info' });
          return;
        }

        if (!campaignSubmit) return;
        campaignSubmit.disabled = true;
        const campaignId = stagedCampaignId;

        try {
          const response = await jsonpRequest<{ result: string; sent?: number; total?: number }>(
            GOOGLE_FORMS_ENDPOINT,
            { action: 'adminSendCampaign', token, campaignId },
          );

          if (response.result === 'unauthorized') return handleSessionExpired();

          if (response.result === 'success') {
            showToast({
              message: `Campaña enviada: ${response.sent} de ${response.total}.`,
              variant: 'success',
            });
            campaignForm.reset();
            invalidatePreview();
          } else {
            // No reintentar solo: si el envío en sí ya salió y lo que se
            // perdió fue la respuesta (corte de red), reintentar acá
            // mandaría la campaña dos veces. La pestaña "Campañas
            // enviadas" de la planilla es la fuente real de si salió o no.
            showToast({
              message: 'No pudimos confirmar el envío — antes de reintentar, revisá la pestaña "Campañas enviadas" de la planilla, puede que ya se haya mandado.',
              variant: 'error',
            });
            invalidatePreview();
          }
        } catch {
          showToast({
            message: 'No pudimos confirmar el envío — antes de reintentar, revisá la pestaña "Campañas enviadas" de la planilla, puede que ya se haya mandado.',
            variant: 'error',
          });
          invalidatePreview();
        } finally {
          campaignSubmit.disabled = false;
        }
      });
    </script>
  </body>
</html>
