---
/**
 * Herramienta interna del staff, no una página del sitio: escanea con la
 * cámara el QR de acceso que ActivityCertificateRegistrationForm.astro le
 * entrega a cada inscripto/a a una charla/capacitación, y marca presente en
 * el Google Sheet vía el Apps Script (acción `checkin`, ver
 * docs/GOOGLE_SHEETS_FORM_SETUP.md). Sin Navbar/Footer (misma idea que
 * public/admin/index.html) y `noindex`: no es contenido del sitio.
 *
 * La única protección es la clave que valida el Apps Script en cada
 * escaneo — nunca queda en el código de esta página, así que no hay nada
 * que "filtrar" mirando el código fuente. Sin login real porque no hace
 * falta identificar a la persona del staff, solo evitar que cualquiera que
 * encuentre la URL pueda marcar gente como presente.
 */
import '@/styles/global.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Escanear asistencia — ATP</title>
  </head>
  <body class="bg-background text-text min-h-screen">
    <div class="mx-auto flex min-h-screen w-full max-w-md flex-col gap-6 p-4">
      <h1 class="text-h4 text-text pt-4 text-center font-bold">Escanear asistencia</h1>

      <form
        data-setup-form
        class="border-border bg-surface flex flex-col gap-4 rounded-md border p-6"
      >
        <div class="flex flex-col gap-2">
          <label for="staff-secret" class="text-caption text-text-secondary font-semibold">
            Clave del staff
          </label>
          <input
            id="staff-secret"
            type="password"
            required
            autocomplete="off"
            class="border-border-strong bg-surface text-body text-text focus:border-secondary-strong h-10 w-full rounded-xs border px-4"
          />
        </div>
        <div class="flex flex-col gap-2">
          <label for="staff-activity" class="text-caption text-text-secondary font-semibold">
            Actividad
          </label>
          <select
            id="staff-activity"
            data-activity-select
            required
            class="border-border-strong bg-surface text-body text-text focus:border-secondary-strong h-10 w-full rounded-xs border px-4"
          >
            <option value="" selected disabled>Cargando actividades…</option>
          </select>
        </div>
        <div class="flex flex-col gap-2">
          <label for="staff-encounter" class="text-caption text-text-secondary font-semibold">
            Encuentro
          </label>
          <select
            id="staff-encounter"
            data-encounter-select
            required
            class="border-border-strong bg-surface text-body text-text focus:border-secondary-strong h-10 w-full rounded-xs border px-4"
          >
            <option value="" selected disabled>Elegí una actividad primero</option>
          </select>
          <input
            id="staff-encounter-text"
            data-encounter-text
            type="text"
            hidden
            placeholder="Ej: Encuentro 1"
            class="border-border-strong bg-surface text-body text-text focus:border-secondary-strong h-10 w-full rounded-xs border px-4"
          />
          <span data-encounter-text-hint hidden class="text-caption text-text-secondary">
            Esta actividad es recurrente y no tiene una lista fija de encuentros — escribí uno (usá
            el mismo nombre en todos los puntos de escaneo de este encuentro, y uno distinto para
            cada encuentro).
          </span>
        </div>
        <button
          type="submit"
          class="bg-primary-fill text-primary-fill-foreground h-12 rounded-sm font-semibold transition-[filter] duration-150 hover:brightness-110"
        >
          Empezar a escanear
        </button>
      </form>

      <div data-scan-view hidden class="flex flex-1 flex-col gap-4">
        <div
          class="border-border bg-surface flex items-center justify-between rounded-md border p-3"
        >
          <span class="text-body-sm text-text-secondary">
            <strong data-activity-label class="text-text"></strong> —
            <strong data-session-label class="text-text"></strong>
          </span>
          <button
            type="button"
            data-change-session
            class="text-body-sm text-secondary-strong font-semibold underline underline-offset-2"
          >
            Cambiar
          </button>
        </div>

        <div
          class="border-border bg-surface grid grid-cols-2 divide-x rounded-md border p-3 text-center"
        >
          <div>
            <p data-count-device class="text-h4 text-text font-extrabold">0</p>
            <p class="text-caption text-text-secondary">Este dispositivo</p>
          </div>
          <div>
            <p data-count-total class="text-h4 text-text font-extrabold">—</p>
            <p class="text-caption text-text-secondary">Total del encuentro</p>
          </div>
        </div>

        <div class="relative aspect-square w-full overflow-hidden rounded-md bg-black">
          <video data-camera-video class="size-full object-cover" playsinline muted></video>
          <canvas data-camera-canvas hidden></canvas>
          <!-- Destello de confirmación: cubre toda la vista de escaneo (no
               solo un cartel chico) para que se note aunque el staff no
               esté mirando el texto — pedido explícito de que "la interfaz
               se ponga toda en verde". Empieza transparente/invisible. -->
          <div
            data-flash-overlay
            class="bg-success pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-150 ease-out"
          >
          </div>
        </div>

        <p data-scan-hint class="text-body-sm text-text-secondary text-center">
          Apuntá la cámara al QR de la entrada. Se marca solo, sin tocar nada.
        </p>

        <div
          data-result-banner
          hidden
          class="fixed inset-x-4 bottom-6 z-50 rounded-md p-5 text-center shadow-lg"
        >
          <p data-result-title class="text-h4 font-bold"></p>
          <p data-result-subtitle class="text-body-sm mt-1"></p>
        </div>
      </div>
    </div>

    <script>
      import jsQR from 'jsqr';
      import { GOOGLE_FORMS_ENDPOINT } from '@/lib/googleFormsEndpoint';
      import { CHECKIN_WORKER_ENDPOINT } from '@/lib/checkinWorkerEndpoint';
      import { jsonpRequest } from '@/lib/jsonp';

      const SESSION_STORAGE_SECRET = 'atp-staff-secret';
      const SESSION_STORAGE_ACTIVITY_ID = 'atp-staff-activity-id';
      const SESSION_STORAGE_ACTIVITY_TITLE = 'atp-staff-activity-title';
      const SESSION_STORAGE_SESSION = 'atp-staff-session-label';
      // Contador de "este dispositivo": vive en sessionStorage (no
      // localStorage) a propósito — se reinicia solo al elegir un
      // encuentro nuevo con "Cambiar", igual que el resto de estos datos,
      // así siempre refleja los escaneos de ESTA tanda, no un total
      // acumulado de todos los eventos que este celular haya escaneado
      // alguna vez.
      const SESSION_STORAGE_DEVICE_COUNT = 'atp-staff-device-count';
      // Ventana durante la que se ignoran nuevas lecturas después de un
      // escaneo exitoso — si no, el mismo QR frente a la cámara dispara el
      // check-in decenas de veces por segundo mientras la persona se aleja.
      const SCAN_COOLDOWN_MS = 2500;

      interface CertificateActivity {
        id: string;
        title: string;
        encounters: string[] | null;
      }

      const setupForm = document.querySelector<HTMLFormElement>('[data-setup-form]');
      const secretInput = document.querySelector<HTMLInputElement>('#staff-secret');
      const activitySelect = document.querySelector<HTMLSelectElement>('[data-activity-select]');
      const encounterSelect = document.querySelector<HTMLSelectElement>('[data-encounter-select]');
      const encounterTextInput = document.querySelector<HTMLInputElement>('[data-encounter-text]');
      const encounterTextHint = document.querySelector<HTMLElement>('[data-encounter-text-hint]');
      const scanView = document.querySelector<HTMLElement>('[data-scan-view]');
      const activityLabelEl = document.querySelector<HTMLElement>('[data-activity-label]');
      const sessionLabelEl = document.querySelector<HTMLElement>('[data-session-label]');
      const changeSessionButton =
        document.querySelector<HTMLButtonElement>('[data-change-session]');
      const video = document.querySelector<HTMLVideoElement>('[data-camera-video]');
      const canvas = document.querySelector<HTMLCanvasElement>('[data-camera-canvas]');
      const resultBanner = document.querySelector<HTMLElement>('[data-result-banner]');
      const resultTitle = document.querySelector<HTMLElement>('[data-result-title]');
      const resultSubtitle = document.querySelector<HTMLElement>('[data-result-subtitle]');
      const flashOverlay = document.querySelector<HTMLElement>('[data-flash-overlay]');
      const countDeviceEl = document.querySelector<HTMLElement>('[data-count-device]');
      const countTotalEl = document.querySelector<HTMLElement>('[data-count-total]');

      const context = canvas?.getContext('2d', { willReadFrequently: true });

      let scanning = false;
      let cooldownUntil = 0;
      let lastDecodeAttempt = 0;
      // Bajado de 200ms: la demora real que se sentía no era esto (ver
      // MAX_DECODE_DIMENSION más abajo y el arreglo del lado del Apps
      // Script, docs/GOOGLE_SHEETS_FORM_SETUP.md) sino el viaje de ida y
      // vuelta al servidor — pero igual conviene que la detección en sí
      // sea lo más ágil posible. 90ms sigue siendo liviano para la
      // batería (~11 intentos/seg, no los ~60 de cada frame) y ya no se
      // nota como un paso extra de espera.
      const DECODE_INTERVAL_MS = 90;
      // Decodificar el frame completo de la cámara (a menudo 1080p o más
      // en un celular actual) es el trabajo más caro de cada intento:
      // getImageData y jsQR procesan cada píxel. Un QR se lee perfecto
      // aunque se lo achique bastante, así que se dibuja en un canvas más
      // chico en vez de a resolución completa — bastantes menos píxeles
      // por intento, sin perder confiabilidad de lectura.
      const MAX_DECODE_DIMENSION = 640;
      let cameraStream: MediaStream | null = null;
      let audioContext: AudioContext | null = null;

      function getDeviceScanCount(): number {
        return Number(sessionStorage.getItem(SESSION_STORAGE_DEVICE_COUNT) ?? '0');
      }

      function setDeviceScanCount(count: number): void {
        sessionStorage.setItem(SESSION_STORAGE_DEVICE_COUNT, String(count));
        if (countDeviceEl) countDeviceEl.textContent = String(count);
      }

      // Beep corto generado con Web Audio (sin archivo de audio que
      // cargar: nada que descargar, cero demora antes del primer
      // sonido). El AudioContext se crea recién al arrancar a escanear
      // (dentro de un gesto real del usuario, el submit del formulario)
      // porque los navegadores móviles bloquean el audio programático
      // que no arranca de una interacción directa — crearlo antes fallaría
      // en silencio en varios celulares.
      function playSuccessSound(): void {
        if (!audioContext) return;
        // En algunos navegadores (Safari/iOS en particular) un
        // AudioContext creado dentro de un gesto puede seguir quedando
        // "suspendido" hasta que algo lo reanuda explícitamente — sin
        // esto, el contexto existe pero ningún sonido se escucha de
        // verdad. Reanudar uno que ya está corriendo no hace nada, así
        // que es seguro llamarlo siempre, no solo la primera vez.
        void audioContext.resume();
        const oscillator = audioContext.createOscillator();
        const gain = audioContext.createGain();
        oscillator.type = 'sine';
        oscillator.frequency.value = 880;
        gain.gain.setValueAtTime(0.3, audioContext.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioContext.currentTime + 0.15);
        oscillator.connect(gain);
        gain.connect(audioContext.destination);
        oscillator.start();
        oscillator.stop(audioContext.currentTime + 0.15);
      }

      function flashGreen(): void {
        if (!flashOverlay) return;
        flashOverlay.classList.remove('opacity-0');
        flashOverlay.classList.add('opacity-80');
        window.setTimeout(() => {
          flashOverlay.classList.remove('opacity-80');
          flashOverlay.classList.add('opacity-0');
        }, 350);
      }

      function getSecret(): string {
        return sessionStorage.getItem(SESSION_STORAGE_SECRET) ?? '';
      }

      function getActivityId(): string {
        return sessionStorage.getItem(SESSION_STORAGE_ACTIVITY_ID) ?? '';
      }

      function getActivityTitle(): string {
        return sessionStorage.getItem(SESSION_STORAGE_ACTIVITY_TITLE) ?? '';
      }

      function getSessionLabel(): string {
        return sessionStorage.getItem(SESSION_STORAGE_SESSION) ?? '';
      }

      // Carga las actividades con certificado una sola vez al abrir la
      // página — es un JSON chico generado en build time (ver
      // certificate-activities.json.ts), no hace falta pedírselo al Apps
      // Script. Sin esto (o si falla), el desplegable de actividad queda
      // vacío — no hay forma de escanear sin elegir una, a propósito: ya
      // no se puede tipear un encuentro "a ciegas" como antes.
      let certificateActivities: CertificateActivity[] = [];

      async function loadCertificateActivities() {
        if (!activitySelect) return;
        try {
          const response = await fetch('/certificate-activities.json');
          const data: { activities: CertificateActivity[] } = await response.json();
          certificateActivities = data.activities;

          activitySelect.innerHTML = '';
          const placeholder = document.createElement('option');
          placeholder.value = '';
          placeholder.disabled = true;
          placeholder.selected = true;
          placeholder.textContent = 'Elegí una actividad';
          activitySelect.appendChild(placeholder);

          certificateActivities.forEach((activity) => {
            const option = document.createElement('option');
            option.value = activity.id;
            option.textContent = activity.title;
            activitySelect.appendChild(option);
          });
        } catch {
          activitySelect.innerHTML =
            '<option value="" selected disabled>No se pudieron cargar las actividades</option>';
        }
      }

      // Al elegir una actividad, arma el desplegable de encuentros con los
      // reales de esa actividad — o, si es recurrente y no tiene una lista
      // fija (ver certificate-activities.json.ts), muestra el campo de
      // texto libre de siempre en su lugar.
      function updateEncounterOptions() {
        if (!encounterSelect || !encounterTextInput || !encounterTextHint) return;
        const activity = certificateActivities.find((a) => a.id === activitySelect?.value);

        if (activity?.encounters) {
          encounterSelect.innerHTML = '';
          const placeholder = document.createElement('option');
          placeholder.value = '';
          placeholder.disabled = true;
          placeholder.selected = true;
          placeholder.textContent = 'Elegí un encuentro';
          encounterSelect.appendChild(placeholder);
          activity.encounters.forEach((label) => {
            const option = document.createElement('option');
            option.value = label;
            option.textContent = label;
            encounterSelect.appendChild(option);
          });
          encounterSelect.hidden = false;
          encounterSelect.required = true;
          encounterTextInput.hidden = true;
          encounterTextInput.required = false;
          encounterTextHint.hidden = true;
        } else {
          encounterSelect.hidden = true;
          encounterSelect.required = false;
          encounterTextInput.hidden = false;
          encounterTextInput.required = true;
          encounterTextHint.hidden = !activity;
        }
      }

      activitySelect?.addEventListener('change', updateEncounterOptions);
      void loadCertificateActivities();

      function showBanner(variant: 'ok' | 'duplicate' | 'error', title: string, subtitle: string) {
        if (!resultBanner || !resultTitle || !resultSubtitle) return;
        const variantClasses: Record<typeof variant, string> = {
          ok: 'bg-success text-success-foreground',
          duplicate: 'bg-warning text-warning-foreground',
          error: 'bg-error text-error-foreground',
        };
        resultBanner.className = [
          'fixed inset-x-4 bottom-6 z-50 rounded-md p-5 text-center shadow-lg',
          variantClasses[variant],
        ].join(' ');
        resultTitle.textContent = title;
        resultSubtitle.textContent = subtitle;
        resultBanner.hidden = false;
        window.setTimeout(() => {
          resultBanner.hidden = true;
        }, SCAN_COOLDOWN_MS - 200);
      }

      // Camino de siempre: JSONP contra Apps Script (no fetch normal, porque
      // ese Web App no manda headers CORS y un fetch no podría leer la
      // respuesta) — más lento (varios segundos, el redirect fijo de Apps
      // Script no se puede evitar), pero es la fuente de verdad definitiva:
      // recorre TODAS las hojas, y es la única que puede devolver
      // "wrong_activity" con certeza. Se usa como respaldo del camino
      // rápido de abajo, nunca como primera opción.
      function requestCheckinViaAppsScript(id: string, sessionLabel: string, secret: string): void {
        jsonpRequest<CheckinResponse>(GOOGLE_FORMS_ENDPOINT, {
          action: 'checkin',
          id,
          session: sessionLabel,
          activityId: getActivityId(),
          secret,
        })
          .then(handleCheckinResponse)
          .catch(() =>
            showBanner('error', 'Sin respuesta', 'Revisá la conexión y probá de nuevo.'),
          );
      }

      // Milisegundos que se espera al Worker de Cloudflare antes de darlo
      // por perdido y caer al camino de Apps Script — medida en
      // producción, una respuesta real del Worker CON SU MEMORIA YA
      // CALENTADA (ver warmUpCheckinWorker más abajo) tarda bastante
      // menos de 1s (~500ms desde una red hogareña), así que 2.5s deja
      // margen para una red de evento más floja sin llegar a sentirse
      // como una espera de más en el caso (raro) de que sí haga falta
      // caer. OJO: la PRIMERA vez que se usa una actividad+encuentro, el
      // Worker tiene que traer el padrón completo de Apps Script (entre 3
      // y 8 segundos, medido) — por eso se lo "calienta" apenas el staff
      // toca "Empezar a escanear", bastante antes de que llegue a apuntar
      // la cámara a la primera persona de verdad.
      const WORKER_TIMEOUT_MS = 2500;

      async function fetchWithTimeout(url: string, body: unknown, timeoutMs: number): Promise<Response> {
        const controller = new AbortController();
        const timeoutId = window.setTimeout(() => controller.abort(), timeoutMs);
        try {
          return await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
            signal: controller.signal,
          });
        } finally {
          window.clearTimeout(timeoutId);
        }
      }

      // Dispara un pedido de calentamiento al Worker (con un id que nunca
      // va a coincidir con ningún inscripto real) apenas se elige la
      // actividad/encuentro — así, para cuando el staff escanea el primer
      // QR de verdad, el Durable Object ya tiene el padrón completo
      // cargado en memoria y responde rápido desde el primer escaneo real.
      // Sin await ni manejo de resultado: si falla (Worker no desplegado,
      // sin red), el primer escaneo real simplemente cae al camino de
      // Apps Script como corresponde, sin que esto rompa nada.
      function warmUpCheckinWorker(sessionLabel: string, secret: string): void {
        // 15s: la primera vez que se usa una actividad/encuentro, el
        // Worker tiene que traerse el padrón completo desde Apps Script —
        // medido en producción entre 3 y 8 segundos según el momento, así
        // que 15s deja margen de sobra. No afecta la percepción del
        // staff: esto corre en segundo plano, sin ningún indicador en
        // pantalla, mientras recién arranca la cámara.
        fetchWithTimeout(
          CHECKIN_WORKER_ENDPOINT,
          { id: '__warmup__', session: sessionLabel, activityId: getActivityId(), secret },
          15000,
        ).catch(() => {
          // Sin acción: el primer escaneo real cae solo al camino lento
          // si esto no llegó a calentar nada.
        });
      }

      // Camino rápido: el Worker de Cloudflare (cloudflare/checkin-worker/)
      // contesta desde su propia memoria, sin ir a Sheets en el camino
      // crítico — y persiste el escaneo en la planilla real en segundo
      // plano. Nunca es la única vía: cualquier falla (sin red, Worker no
      // desplegado, timeout) cae sola al camino de Apps Script de siempre,
      // así que un problema puntual del lado de Cloudflare nunca deja el
      // escaneo sin funcionar del todo. También cae al camino lento ante
      // un "not_found" del Worker (no "todavía no lo tenemos en nuestra
      // memoria rápida", sino "puede ser de otra actividad" — el Worker
      // solo conoce la actividad elegida, así que un QR de una actividad
      // distinta necesita el recorrido completo de Apps Script para
      // devolver el "wrong_activity" correcto en vez de un "no reconocido"
      // engañoso).
      function requestCheckin(id: string, sessionLabel: string, secret: string): void {
        fetchWithTimeout(
          CHECKIN_WORKER_ENDPOINT,
          { id, session: sessionLabel, activityId: getActivityId(), secret },
          WORKER_TIMEOUT_MS,
        )
          .then((response) => response.json() as Promise<CheckinResponse>)
          .then((result) => {
            if (result.result === 'not_found') {
              requestCheckinViaAppsScript(id, sessionLabel, secret);
              return;
            }
            handleCheckinResponse(result);
          })
          .catch(() => requestCheckinViaAppsScript(id, sessionLabel, secret));
      }

      interface CheckinResponse {
        result: 'ok' | 'duplicate' | 'not_found' | 'unauthorized' | 'wrong_activity' | 'error';
        name?: string;
        totalForSession?: number;
      }

      function handleCheckinResponse(response: CheckinResponse) {
        switch (response.result) {
          case 'ok':
            // Sonido + pantalla en verde solo acá, en el resultado
            // CONFIRMADO por el servidor (nunca al simplemente detectar
            // el QR): si se disparara antes de la confirmación real, un
            // duplicado/actividad equivocada/QR ajeno se vería y sonaría
            // exactamente igual que un ingreso válido.
            playSuccessSound();
            flashGreen();
            setDeviceScanCount(getDeviceScanCount() + 1);
            if (countTotalEl && typeof response.totalForSession === 'number') {
              countTotalEl.textContent = String(response.totalForSession);
            }
            showBanner('ok', `✓ ${response.name ?? 'Presente'}`, 'Asistencia registrada.');
            break;
          case 'duplicate':
            showBanner(
              'duplicate',
              response.name ?? 'Ya había entrado',
              'Ya estaba marcado en este encuentro.',
            );
            break;
          case 'not_found':
            showBanner('error', 'QR no reconocido', 'No corresponde a ninguna inscripción.');
            break;
          case 'wrong_activity':
            showBanner(
              'error',
              response.name ?? 'Actividad equivocada',
              'Este QR es de otra actividad, no de la que elegiste arriba.',
            );
            break;
          case 'unauthorized':
            showBanner('error', 'Clave incorrecta', 'Tocá "Cambiar" y volvé a escribirla bien.');
            break;
          default:
            showBanner('error', 'Error', 'Probá escanear de nuevo.');
        }
      }

      function tick() {
        if (!scanning || !video || !canvas || !context) return;

        const now = Date.now();
        if (
          video.readyState === video.HAVE_ENOUGH_DATA &&
          now >= cooldownUntil &&
          now - lastDecodeAttempt >= DECODE_INTERVAL_MS
        ) {
          lastDecodeAttempt = now;
          const scale = Math.min(
            1,
            MAX_DECODE_DIMENSION / Math.max(video.videoWidth, video.videoHeight),
          );
          canvas.width = Math.round(video.videoWidth * scale);
          canvas.height = Math.round(video.videoHeight * scale);
          context.drawImage(video, 0, 0, canvas.width, canvas.height);
          const imageData = context.getImageData(0, 0, canvas.width, canvas.height);

          // Sin inversionAttempts explícito (jsQR prueba ambas variantes
          // de color por default): se probó forzar 'dontInvert' para
          // ahorrar trabajo, ya que el QR siempre sale oscuro-sobre-claro
          // — se revierte por las dudas ante un reporte de "QR no
          // reconocido" en un iPhone que dejó de repetirse al sacar esto
          // (no confirmado del todo como la causa real, pero el costo de
          // sacarlo es bajo y el de mantenerlo roto en algún celular es
          // alto).
          const code = jsQR(imageData.data, imageData.width, imageData.height);
          if (code?.data) {
            cooldownUntil = Date.now() + SCAN_COOLDOWN_MS;
            requestCheckin(code.data, getSessionLabel(), getSecret());
          }
        }

        window.requestAnimationFrame(tick);
      }

      async function startCamera() {
        try {
          cameraStream = await navigator.mediaDevices.getUserMedia({
            video: { facingMode: 'environment' },
          });
          if (video) {
            video.srcObject = cameraStream;
            await video.play();
          }
          scanning = true;
          window.requestAnimationFrame(tick);
        } catch {
          showBanner('error', 'No se pudo abrir la cámara', 'Revisá los permisos del navegador.');
        }
      }

      function enterScanView() {
        if (setupForm) setupForm.hidden = true;
        if (scanView) scanView.hidden = false;
        if (activityLabelEl) activityLabelEl.textContent = getActivityTitle();
        if (sessionLabelEl) sessionLabelEl.textContent = getSessionLabel();
        if (countDeviceEl) countDeviceEl.textContent = String(getDeviceScanCount());
        if (countTotalEl) countTotalEl.textContent = '—';
        warmUpCheckinWorker(getSessionLabel(), getSecret());
        void startCamera();
      }

      setupForm?.addEventListener('submit', (event) => {
        event.preventDefault();
        const secret = secretInput?.value.trim();
        const activityId = activitySelect?.value;
        const activityTitle = activitySelect?.selectedOptions[0]?.textContent ?? '';
        const usingTextFallback = encounterTextInput && !encounterTextInput.hidden;
        const sessionLabel = (
          usingTextFallback ? encounterTextInput?.value : encounterSelect?.value
        )?.trim();
        if (!secret || !activityId || !sessionLabel) return;
        sessionStorage.setItem(SESSION_STORAGE_SECRET, secret);
        sessionStorage.setItem(SESSION_STORAGE_ACTIVITY_ID, activityId);
        sessionStorage.setItem(SESSION_STORAGE_ACTIVITY_TITLE, activityTitle);
        sessionStorage.setItem(SESSION_STORAGE_SESSION, sessionLabel);
        sessionStorage.setItem(SESSION_STORAGE_DEVICE_COUNT, '0');
        // Creado acá, dentro del propio gesto de tocar "Empezar a
        // escanear" — algunos navegadores de celular bloquean cualquier
        // audio programático que no arranque de una interacción directa
        // como esta.
        try {
          audioContext = new AudioContext();
        } catch {
          // Sin sonido en este navegador — no bloquea el resto del flujo.
        }
        enterScanView();
      });

      changeSessionButton?.addEventListener('click', () => {
        scanning = false;
        cameraStream?.getTracks().forEach((track) => track.stop());
        sessionStorage.removeItem(SESSION_STORAGE_SECRET);
        sessionStorage.removeItem(SESSION_STORAGE_ACTIVITY_ID);
        sessionStorage.removeItem(SESSION_STORAGE_ACTIVITY_TITLE);
        sessionStorage.removeItem(SESSION_STORAGE_SESSION);
        sessionStorage.removeItem(SESSION_STORAGE_DEVICE_COUNT);
        if (scanView) scanView.hidden = true;
        if (setupForm) setupForm.hidden = false;
        if (secretInput) secretInput.value = '';
        if (activitySelect) activitySelect.selectedIndex = 0;
        if (encounterTextInput) encounterTextInput.value = '';
        updateEncounterOptions();
      });

      if (getSecret() && getActivityId() && getSessionLabel()) {
        // Retomar una sesión ya empezada (p. ej. se refrescó la página
        // sin querer) no es un gesto directo del usuario — el
        // AudioContext puede quedar "suspendido" hasta el próximo toque
        // en la pantalla, así que el sonido podría no escucharse hasta
        // entonces. No vale la pena más que esto: es un caso raro, y
        // ni el silencio momentáneo ni el intento fallido rompen nada.
        try {
          audioContext = new AudioContext();
        } catch {
          // Sin sonido en este navegador — no bloquea el resto del flujo.
        }
        enterScanView();
      }
    </script>
  </body>
</html>
