---
/**
 * Biblioteca. Content is local (src/content/books + subjects +
 * resourceTypes), no backend involved — "subjects" and "resourceTypes" are
 * their own CMS-editable collections (not fixed enums) so ATP can add a new
 * materia or tipo de recurso (ej. "Cuaderno del alumno", "Inmunología") from
 * the CMS itself, without a code change.
 *
 * Pensada primero para el celular (rediseño 2026-10-22): lista compacta
 * agrupada por materia, con las ediciones de un mismo libro juntas
 * (BookListItem + src/lib/bookGroups.ts). Arriba, fijos al bajar: el
 * buscador, el botón "Filtros" (Carrera y Tipo, en un panel desde abajo) y
 * una fila deslizable de materias. Al buscar, los resultados que mejor
 * coinciden suben primero, dentro de cada materia y entre materias.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import Container from '@/components/Container.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import Button from '@/components/Button.astro';
import Modal from '@/components/Modal.astro';
import SearchBar from '@/components/SearchBar.astro';
import ChipRadioGroup from '@/components/ChipRadioGroup.astro';
import FilterChip from '@/components/FilterChip.astro';
import BookListItem from '@/components/BookListItem.astro';
import EmptyState from '@/components/EmptyState.astro';
import LibraryNotice from '@/components/LibraryNotice.astro';
import QuickSearchPills from '@/components/QuickSearchPills.astro';
import { getCollection } from 'astro:content';
import { careerLabels, type CareerSlug } from '@/lib/labels';
import { groupBookEditions } from '@/lib/bookGroups';
import { getRecentLibrarySearches } from '@/lib/goatcounter';
import { buildFrequentSearches } from '@/lib/frequentSearches';
import SlidersHorizontal from '@lucide/astro/icons/sliders-horizontal';

const publishedBooks = await getCollection('books', ({ data }) => data.published);

const subjects = await getCollection('subjects');
const resourceTypes = await getCollection('resourceTypes');
const subjectNames = new Map(subjects.map((entry) => [entry.id, entry.data.name]));
const resourceTypeNames = new Map(resourceTypes.map((entry) => [entry.id, entry.data.name]));

// Un slug sin entrada en su colección se muestra tal cual en vez de
// descartarse: un libro con una materia mal cargada sigue apareciendo.
function sortedUsedOptions(names: Map<string, string>, usedSlugs: Set<string>) {
  return [...usedSlugs]
    .map((slug) => ({ value: slug, label: names.get(slug) ?? slug }))
    .sort((a, b) => a.label.localeCompare(b.label, 'es'));
}

const usedSubjectSlugs = new Set(publishedBooks.map((book) => book.data.subject));
const usedResourceTypeSlugs = new Set(publishedBooks.map((book) => book.data.resourceType));
const subjectOptions = sortedUsedOptions(subjectNames, usedSubjectSlugs);
const resourceTypeOptions = sortedUsedOptions(resourceTypeNames, usedResourceTypeSlugs);
// Solo carreras con algún libro: elegir una vacía siempre deja la lista en
// blanco. Con una sola (hoy todo es Medicina), el filtro no se muestra.
const usedCareers = new Set(publishedBooks.flatMap((book) => book.data.career));
const careerOptions = (Object.entries(careerLabels) as [CareerSlug, string][])
  .filter(([value]) => usedCareers.has(value))
  .map(([value, label]) => ({ value, label }));

const bookGroups = groupBookEditions(publishedBooks);
const sections = subjectOptions.map(({ value: slug, label: name }) => ({
  slug,
  name,
  groups: bookGroups
    .filter(([latest]) => latest.data.subject === slug)
    .sort(
      ([a], [b]) =>
        (a.data.order ?? Infinity) - (b.data.order ?? Infinity) ||
        a.data.title.localeCompare(b.data.title, 'es'),
    ),
}));

// "Más buscados": lo que la gente buscó en los últimos 30 días (GoatCounter,
// se actualiza con el deploy diario). Sin datos, las materias con más libros.
const subjectBookCounts = new Map<string, number>();
for (const book of publishedBooks) {
  subjectBookCounts.set(book.data.subject, (subjectBookCounts.get(book.data.subject) ?? 0) + 1);
}
const subjectsByBookCount = [...subjectBookCounts.entries()]
  .filter(([slug]) => subjectNames.has(slug))
  .sort((a, b) => b[1] - a[1])
  .map(([slug]) => ({ label: subjectNames.get(slug)!, query: subjectNames.get(slug)! }));
const frequentSearches = buildFrequentSearches(
  await getRecentLibrarySearches(),
  publishedBooks.map((book) => ({
    text: `${book.data.author} ${book.data.title} ${subjectNames.get(book.data.subject) ?? ''}`,
  })),
  subjectsByBookCount,
);

// Chips de los filtros del panel que están activos, para que se vea por qué
// la lista está recortada aunque el panel esté cerrado.
const filterChips = [
  ...careerOptions.map(({ value, label }) => ({ value: `carrera:${value}`, label })),
  ...resourceTypeOptions.map(({ value, label }) => ({ value: `tipo:${value}`, label })),
];
---

<BaseLayout
  title="Biblioteca: apuntes y material de estudio"
  description="Material de estudio de la Facultad de Ciencias Médicas (UNR): apuntes, resúmenes y guías de Medicina, Enfermería, Fonoaudiología y Terapia Ocupacional, organizados por materia y carrera."
  canonicalPath="/biblioteca/"
>
  <Section spacing="sm" reveal={false}>
    <Container class="flex flex-col">
      <SectionHeader
        as="h1"
        title="Biblioteca"
        description="Apuntes, resúmenes y guías de estudio de la FCM (UNR), organizados por materia y carrera."
      />

      <!-- Marca dónde arranca la barra: cuando sale de pantalla, la barra ya
           está pegada arriba y se le agrega sombra (ver script). -->
      <div data-library-toolbar-sentinel aria-hidden="true" class="mt-6"></div>

      <!-- Fija solo hasta `lg`: en compu las materias ocupan varias filas y,
           pegadas arriba, taparían un tercio de la pantalla. -->
      <div
        data-library-toolbar
        class="bg-background z-dropdown data-stuck:border-border ease-standard sticky top-16 -mx-4 flex flex-col gap-3 border-b border-transparent px-4 py-3 transition-[box-shadow,border-color] duration-200 data-stuck:shadow-sm md:-mx-6 md:px-6 lg:static lg:data-stuck:border-transparent lg:data-stuck:shadow-none xl:-mx-8 xl:px-8"
      >
        <div class="flex gap-2">
          <SearchBar
            data-library-search
            label="Buscar por título o autor"
            placeholder="Libro o autor…"
            class="min-w-0 flex-1"
          />
          <Button
            variant="outline"
            data-modal-open="library-filters"
            class="relative h-11 shrink-0 px-3"
          >
            <SlidersHorizontal slot="icon-start" class="size-4" aria-hidden="true" />
            Filtros
            <span
              data-filter-count
              hidden
              class="bg-secondary text-secondary-foreground text-caption absolute -top-2 -right-2 inline-flex size-5 items-center justify-center rounded-full font-bold"
            >
            </span>
          </Button>
        </div>

        <ChipRadioGroup
          name="materia"
          legend="Materia"
          hideLegend
          layout="scroll"
          options={[{ value: 'all', label: 'Todas' }, ...subjectOptions]}
          value="all"
        />

        <div data-active-filters hidden class="flex flex-wrap gap-2">
          {filterChips.map(({ value, label }) => <FilterChip value={value} label={label} hidden />)}
        </div>
      </div>

      <QuickSearchPills
        items={frequentSearches}
        label="Más buscados"
        layout="scroll"
        class="mt-3"
      />

      <div data-library-results class="mt-6 flex flex-col gap-10">
        {
          sections.map(({ slug, name, groups }) => (
            <section data-subject-section={slug} aria-labelledby={`materia-${slug}`}>
              <h2
                id={`materia-${slug}`}
                class="text-h4 text-text border-border flex items-baseline gap-2 border-b pb-2 font-bold"
              >
                {name}
                <span class="text-body-sm text-text-secondary font-semibold">
                  <span data-section-count>{groups.length}</span>
                  <span class="sr-only">libros</span>
                </span>
              </h2>
              <ul class="*:border-border grid *:border-b lg:grid-cols-2 lg:gap-x-10">
                {groups.map((editions) => (
                  <BookListItem editions={editions} subjectName={name} />
                ))}
              </ul>
            </section>
          ))
        }
      </div>

      <EmptyState
        data-library-empty
        hidden
        title="No encontramos nada con esa búsqueda"
        description="Probá con otra palabra o cambiá los filtros."
      />

      <div class="mt-12">
        <LibraryNotice />
      </div>
    </Container>
  </Section>

  <Modal id="library-filters" variant="sheet">
    <span slot="title">Filtros</span>
    <div class="flex flex-col gap-6">
      {
        careerOptions.length > 1 && (
          <ChipRadioGroup
            name="carrera"
            legend="Carrera"
            options={[{ value: 'all', label: 'Todas' }, ...careerOptions]}
            value="all"
          />
        )
      }
      <ChipRadioGroup
        name="tipo"
        legend="Tipo de material"
        options={[{ value: 'all', label: 'Todos' }, ...resourceTypeOptions]}
        value="all"
      />
    </div>
    <Fragment slot="actions">
      <Button variant="ghost" data-library-filters-clear>Limpiar filtros</Button>
      <Button variant="secondary" data-modal-close data-library-filters-apply>Ver resultados</Button
      >
    </Fragment>
  </Modal>
</BaseLayout>

<script>
  import { toSearchWords, queryRank, normalizeText } from '@/lib/textSearch';

  // Fase 12 — Analíticas: qué buscan los estudiantes (GoatCounter, ver
  // BaseLayout.astro). Debounced: un evento por búsqueda "asentada", no uno
  // por tecla — evitar ruido en el panel de analíticas.
  declare global {
    interface Window {
      goatcounter?: { count: (options: { path: string; event?: boolean }) => void };
    }
  }

  const FILTER_NAMES = ['materia', 'carrera', 'tipo'];

  const items = [...document.querySelectorAll<HTMLElement>('[data-book-item]')];
  const sections = [...document.querySelectorAll<HTMLElement>('[data-subject-section]')];
  const resultsRoot = document.querySelector<HTMLElement>('[data-library-results]');
  const toolbar = document.querySelector<HTMLElement>('[data-library-toolbar]');
  const toolbarSentinel = document.querySelector<HTMLElement>('[data-library-toolbar-sentinel]');
  const searchInput = document.querySelector<HTMLInputElement>('[data-library-search]');
  const emptyState = document.querySelector<HTMLElement>('[data-library-empty]');
  const filterCount = document.querySelector<HTMLElement>('[data-filter-count]');
  const activeFilters = document.querySelector<HTMLElement>('[data-active-filters]');
  const filterChips = document.querySelectorAll<HTMLElement>('[data-filter-chip]');
  const applyButton = document.querySelector<HTMLElement>('[data-library-filters-apply]');
  const quickSearches = document.querySelectorAll<HTMLButtonElement>('[data-quick-search]');

  const itemWords = new Map(items.map((item) => [item, toSearchWords(item.dataset.search ?? '')]));
  // Orden original (alfabético) para desempatar: sin búsqueda, todo vuelve
  // a como estaba aunque el DOM haya quedado reordenado por una anterior.
  const originalIndex = new Map<HTMLElement, number>(
    [...items, ...sections].map((element, index) => [element, index]),
  );
  const byRank = (a: { element: HTMLElement; rank: number }, b: typeof a) =>
    a.rank - b.rank || originalIndex.get(a.element)! - originalIndex.get(b.element)!;

  function checkedValue(name: string): string {
    return (
      document.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value ?? 'all'
    );
  }

  function setChecked(name: string, value: string) {
    const input = document.querySelector<HTMLInputElement>(
      `input[name="${name}"][value="${value}"]`,
    );
    if (input) input.checked = true;
  }

  function applyFilters() {
    const subject = checkedValue('materia');
    const career = checkedValue('carrera');
    const type = checkedValue('tipo');
    const query = searchInput?.value ?? '';
    let visibleCount = 0;

    // Dentro de cada materia, los que mejor coinciden primero; y las
    // materias, según su mejor resultado (buscar "abbas" sube Inmunología).
    // Se reordena el DOM y no con CSS `order`, para que teclado y lector de
    // pantalla sigan el mismo orden que se ve.
    const rankedSections = sections.map((section) => {
      const inSubject = subject === 'all' || section.dataset.subjectSection === subject;
      const rankedItems = [...section.querySelectorAll<HTMLElement>('[data-book-item]')]
        .map((item) => {
          const careers = (item.dataset.career ?? '').split(' ');
          const matchesFilters =
            inSubject &&
            (career === 'all' || careers.includes(career)) &&
            (type === 'all' || item.dataset.resourceType === type);
          const rank = matchesFilters ? queryRank(query, itemWords.get(item) ?? []) : null;
          item.hidden = rank === null;
          return { element: item, rank: rank ?? Infinity };
        })
        .sort(byRank);

      section.querySelector('ul')?.append(...rankedItems.map(({ element }) => element));
      const sectionVisible = rankedItems.filter(({ element }) => !element.hidden).length;
      section.hidden = sectionVisible === 0;
      const count = section.querySelector<HTMLElement>('[data-section-count]');
      if (count) count.textContent = String(sectionVisible);
      visibleCount += sectionVisible;
      return { element: section, rank: rankedItems[0]?.rank ?? Infinity };
    });
    resultsRoot?.append(...rankedSections.sort(byRank).map(({ element }) => element));

    if (resultsRoot) resultsRoot.hidden = visibleCount === 0;
    if (emptyState) emptyState.hidden = visibleCount !== 0;
    if (applyButton) {
      applyButton.textContent =
        visibleCount === 0
          ? 'Ver resultados'
          : `Ver ${visibleCount} ${visibleCount === 1 ? 'libro' : 'libros'}`;
    }

    const activeValues = [
      career !== 'all' && `carrera:${career}`,
      type !== 'all' && `tipo:${type}`,
    ].filter(Boolean);
    filterChips.forEach((chip) => {
      chip.hidden = !activeValues.includes(chip.dataset.filterChip ?? '');
    });
    if (activeFilters) activeFilters.hidden = activeValues.length === 0;
    if (filterCount) {
      filterCount.hidden = activeValues.length === 0;
      filterCount.textContent = String(activeValues.length);
    }

    const normalizedQuery = normalizeText(query.trim());
    quickSearches.forEach((button) => {
      const isActive = normalizeText(button.dataset.quickSearch ?? '') === normalizedQuery;
      button.setAttribute('aria-pressed', String(isActive && normalizedQuery !== ''));
    });
  }

  // Si se cambia la búsqueda o un filtro con la lista ya bajada, volver al
  // principio de los resultados: si no, la pantalla queda en el medio de
  // una lista nueva (o vacía) sin que se entienda qué pasó.
  function showResultsFromTop() {
    if (!resultsRoot || !toolbar?.hasAttribute('data-stuck')) return;
    const toolbarBottom = toolbar.getBoundingClientRect().bottom;
    const resultsTop = resultsRoot.getBoundingClientRect().top;
    if (resultsTop < toolbarBottom) {
      window.scrollBy({ top: resultsTop - toolbarBottom - 12 });
    }
  }

  function onFiltersChanged() {
    applyFilters();
    showResultsFromTop();
  }

  document.addEventListener('change', (event) => {
    const target = event.target;
    if (target instanceof HTMLInputElement && FILTER_NAMES.includes(target.name)) {
      onFiltersChanged();
    }
  });
  searchInput?.addEventListener('input', onFiltersChanged);

  // Sombra en la barra solo mientras está pegada arriba. 64px = alto del
  // Navbar (h-16), que es donde se pega.
  if (toolbar && toolbarSentinel) {
    new IntersectionObserver(
      ([entry]) => {
        const isStuck = entry.boundingClientRect.top < (entry.rootBounds?.top ?? 0);
        toolbar.toggleAttribute('data-stuck', isStuck);
      },
      { rootMargin: '-64px 0px 0px 0px' },
    ).observe(toolbarSentinel);
  }

  // Pre-carga la búsqueda si se llega con ?q= (el buscador global,
  // GlobalSearch.astro, manda acá así para un libro puntual — la
  // biblioteca no tiene página propia por libro).
  const queryParam = new URLSearchParams(window.location.search).get('q');
  if (queryParam && searchInput) searchInput.value = queryParam;

  let searchTrackTimeout: ReturnType<typeof setTimeout> | undefined;
  searchInput?.addEventListener('input', () => {
    clearTimeout(searchTrackTimeout);
    searchTrackTimeout = setTimeout(() => {
      const query = searchInput.value.trim().toLowerCase();
      if (!query) return;
      window.goatcounter?.count({ path: `busqueda:${query}`, event: true });
      // Para saber qué libros piden que todavía no tenemos: además del
      // evento de arriba (todas las búsquedas), este solo se dispara
      // cuando la búsqueda no encontró ningún resultado — filtrable en
      // GoatCounter por separado, sin tener que revisar búsqueda por
      // búsqueda cuáles dieron vacío.
      if (emptyState && !emptyState.hidden) {
        window.goatcounter?.count({ path: `busqueda-sin-resultado:${query}`, event: true });
      }
    }, 600);
  });

  // Pills de "Más buscados" (QuickSearchPills.astro): completan el buscador,
  // o lo vacían si ya estaba activa. Se registran como `busqueda-rapida:` y
  // no como `busqueda:` — si contaran como búsqueda, las pills que ya se ven
  // sumarían clics por estar a la vista y nunca bajarían del ranking que las
  // genera (src/lib/frequentSearches.ts).
  document.addEventListener('quicksearch:select', ((event: CustomEvent<{ query: string }>) => {
    if (!searchInput) return;
    const query = event.detail?.query ?? '';
    const isActive = normalizeText(searchInput.value.trim()) === normalizeText(query);
    searchInput.value = isActive ? '' : query;
    onFiltersChanged();
    if (!isActive) {
      window.goatcounter?.count({ path: `busqueda-rapida:${normalizeText(query)}`, event: true });
    }
  }) as EventListener);

  document.addEventListener('filterchip:remove', ((event: CustomEvent<{ value: string }>) => {
    const [name] = (event.detail?.value ?? '').split(':');
    setChecked(name, 'all');
    onFiltersChanged();
  }) as EventListener);

  document.querySelector('[data-library-filters-clear]')?.addEventListener('click', () => {
    setChecked('carrera', 'all');
    setChecked('tipo', 'all');
    onFiltersChanged();
  });

  applyFilters();
</script>
