---
import '@/styles/global.css';
import { resolveSeo } from '@/lib/seo';
import { siteConfig } from '@/config/site';
import type { SeoProps } from '@/types/seo';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import Toast from '@/components/Toast.astro';
import GlobalSearch from '@/components/GlobalSearch.astro';
import Modal from '@/components/Modal.astro';
import Button from '@/components/Button.astro';
import TriangleAlert from '@lucide/astro/icons/triangle-alert';

type Props = SeoProps;

const seo = resolveSeo(Astro.props, Astro.site);

// Organization + WebSite: identidad de marca genérica para todo el sitio.
// No hay datos estructurados por tipo de contenido (Event para actividades,
// Book para biblioteca, etc.) todavía: las fechas de actividades siguen
// mezclando texto libre viejo ("22 de agosto") con ISO nuevo del CMS
// (ver src/content.config.ts), y Event exige startDate en ISO — agregarlo
// ahora emitiría datos estructurados inválidos para el contenido viejo.
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteConfig.name,
  // El dominio y lo que la gente efectivamente busca es "ATP FCM"
  // (Facultad de Ciencias Médicas) — ayuda a que Google conecte esa
  // búsqueda con esta entidad en vez de con el podcast homónimo
  // "ATP.fm" (Accidental Tech Podcast), que domina esas siglas.
  alternateName: 'ATP FCM',
  url: Astro.site?.toString(),
  logo: seo.ogImage,
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  url: Astro.site?.toString(),
};
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Scroll-reveal progressive enhancement (see global.css): must run
         before paint so `[data-reveal]` never flashes visible-then-hidden. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <meta name="generator" content={Astro.generator} />

    <!-- Fase 13: precargar solo el peso que se usa para texto de cuerpo en
         casi toda página — evita el salto de fuente (FOUT) en el contenido
         principal. Los demás pesos (headings, negritas) ya usan
         font-display: swap y no bloquean el render. -->
    <link
      rel="preload"
      href="/branding/Montserrat-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Fase 16 (QA): Lighthouse marcó el H1 (font-extrabold) como elemento
         LCP en casi todas las páginas — sin precarga, el navegador recién
         descubre este peso al parsear el CSS, encadenando la descarga
         después de la hoja de estilos en vez de en paralelo con el HTML. -->
    <link
      rel="preload"
      href="/branding/Montserrat-ExtraBold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Auditoría de julio 2026: mismo problema que arriba, encontrado con
         Lighthouse en el peso Bold y SemiBold (nav, botones, subtítulos y
         eyebrows en font-semibold/font-bold aparecen sobre el pliegue en
         casi toda página) — sin esto, la cadena HTML → CSS → fuente medía
         ~4.8s, más que la propia foto del hero. -->
    <link
      rel="preload"
      href="/branding/Montserrat-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/branding/Montserrat-SemiBold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    {seo.canonicalUrl && <link rel="canonical" href={seo.canonicalUrl} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content={seo.ogImage} />
    {seo.canonicalUrl && <meta property="og:url" content={seo.canonicalUrl} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#f969d7" />

    <!-- Fase 15 (PWA): iOS no lee manifest.webmanifest para el ícono ni el
         modo standalone, necesita estas etiquetas propias. -->
    <link rel="apple-touch-icon" href="/branding/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={siteConfig.name} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />

    <!--
      GoatCounter (Fase 12 — Analíticas): sin cookies, sin datos personales,
      no requiere banner de consentimiento. Cuenta pageviews automáticamente;
      los eventos de descargas/botones/búsquedas se agregan por separado vía
      `data-goatcounter-click` (ver Button.astro) o `goatcounter.count(...)`
      (ver biblioteca.astro). Ver docs/ANALYTICS_SETUP.md.
    -->
    <!-- El script (gc.zgo.at) recién descubre este otro origen al
         ejecutarse — precargar la conexión en paralelo evita esa demora
         (Lighthouse lo marcaba como candidato a preconnect, ~885ms de
         ahorro estimado). -->
    <link rel="preconnect" href={`https://${siteConfig.goatcounterSite}.goatcounter.com`} />
    <!-- A diferencia de Sveltia CMS (public/admin/index.html, sin SRI a
         propósito): este script cambia poco y no hace falta actualizarlo
         seguido, así que sí vale fijar su integridad. Si GoatCounter
         publica una versión nueva de count.js, este hash deja de matchear
         y el navegador lo bloquea (analíticas dejan de contar hasta
         recalcular el hash) — no rompe nada más del sitio. -->
    <script
      is:inline
      data-goatcounter={`https://${siteConfig.goatcounterSite}.goatcounter.com/count`}
      async
      src="https://gc.zgo.at/count.js"
      integrity="sha384-2UjvVpptg4JlEVgJI2PdscrjOjPcil/4F1ZvIMJ81CShQnEDSlPI+l4PfogvTLYi"
      crossorigin="anonymous"></script>

    <!--
      Microsoft Clarity (Fase 17 — UX): grabación de sesiones + mapas de
      calor, complementa a GoatCounter (que solo cuenta vistas/clics, no
      "cómo" navega la gente). `define:vars` obliga a `is:inline` (Astro
      no puede procesar un script con variables inyectadas en build time)
      — mismo mecanismo de hash automático por página que ya usa el
      script de GoatCounter de arriba, no hace falta `'unsafe-inline'` en
      la CSP. Nunca corre en /staff/** porque esas páginas no usan este
      layout (tienen su propio <html> aparte) — no hace falta excluirlas
      a mano.

      Privacidad: los campos de teléfono/email/DNI de los formularios del
      sitio llevan `data-clarity-mask="true"` (ver ActivityRegistrationForm,
      ActivityCertificateRegistrationForm, AgendaSaleSection, sumate.astro)
      para que una grabación de sesión nunca muestre esos datos en texto
      plano, aunque alguien los haya tipeado.
    -->
    <script is:inline define:vars={{ clarityProjectId: siteConfig.clarityProjectId }}>
      (function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function () {
            // eslint-disable-next-line prefer-rest-params -- snippet oficial de Microsoft, sin modificar
            (c[a].q = c[a].q || []).push(arguments);
          };
        t = l.createElement(r);
        t.async = 1;
        t.src = 'https://www.clarity.ms/tag/' + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, 'clarity', 'script', clarityProjectId);
    </script>

    <!-- Fase 15 (PWA): habilita instalación y uso offline básico. -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js');
        });
      }
    </script>
  </head>
  <body>
    <a
      href="#main-content"
      class="focus:z-tooltip focus:bg-primary-fill focus:text-primary-fill-foreground sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:rounded-sm focus:px-4 focus:py-2 focus:font-semibold"
    >
      Saltar al contenido principal
    </a>
    <Navbar />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <Toast />
    <GlobalSearch />

    <!--
      Auditoría UX 2026-09-14 (Clarity): ~64% de las sesiones reales llegan
      desde el navegador embebido de Instagram, que confirmado en vivo por
      el dueño no logra descargar los libros de la Biblioteca (ni en pestaña
      nueva ni en la misma) — es una limitación de ese navegador, no del
      sitio. La única salida confiable es que la persona abra el link en su
      navegador de verdad; Instagram ya tiene esa opción en su propio menú,
      así que alcanza con avisar que existe. Modal (no una barrita) a
      propósito: tiene que ser imposible de no ver. Se abre solo clickeando
      el trigger oculto de abajo, nunca llamando showModal() directo (ver
      docs/UI_COMPONENTS.md, patrón de Modal.astro) — el texto exacto de
      cada paso lo completa el script según sea iOS o Android, porque el
      menú de Instagram no está en el mismo lugar ni se llama igual en los
      dos.
    -->
    <button type="button" data-modal-open="instagram-browser-warning" hidden>
      Abrir aviso de navegador
    </button>
    <Modal id="instagram-browser-warning">
      <Fragment slot="title">
        <span class="flex items-center gap-2">
          <TriangleAlert class="text-warning-strong size-6 shrink-0" aria-hidden="true" />
          Instagram no deja descargar bien
        </span>
      </Fragment>
      <p id="instagram-browser-warning-steps" class="text-body text-text text-center"></p>
      <Button slot="actions" data-modal-close variant="primary">Entendido</Button>
    </Modal>

    <script>
      import { initScrollReveal } from '@/lib/scrollReveal';

      initScrollReveal();

      // Ver comentario arriba del modal: solo se abre si el navegador real
      // es el embebido de Instagram/Facebook (WebView), nunca en uno de
      // verdad. El texto de los pasos cambia según iOS o Android porque el
      // menú para "abrir en el navegador" no está en el mismo lugar en los
      // dos sistemas.
      const ua = navigator.userAgent;
      if (/Instagram|FBAN|FBAV/i.test(ua)) {
        const isIOS = /iPhone|iPad|iPod/i.test(ua);
        const steps = document.getElementById('instagram-browser-warning-steps');
        if (steps) {
          steps.textContent = isIOS
            ? 'No es un error nuestro: es el navegador de Instagram. Tocá los tres puntitos y elegí "Abrir en navegador externo", o cerrá este aviso y seguí igual.'
            : 'No es un error nuestro: es el navegador de Instagram. Buscá la opción de abrir en tu navegador (arriba a la derecha), o cerrá este aviso y seguí igual.';
        }
        document
          .querySelector<HTMLElement>('[data-modal-open="instagram-browser-warning"]')
          ?.click();
      }
    </script>
  </body>
</html>
