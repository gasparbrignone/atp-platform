---
/**
 * Generic centered dialog for confirmations, expanded info or quick actions.
 * Decoupled from its trigger(s) via data attributes — any button anywhere
 * on the page with `data-modal-open={id}` opens this modal, and any element
 * inside it with `data-modal-close` closes it. This lets multiple, unrelated
 * components open the same modal without prop-drilling a click handler.
 *
 * `variant="sheet"`: panel que sube desde abajo, a lo ancho — en el celular
 * queda al alcance del pulgar (ej. los filtros de la Biblioteca).
 */
import type { HTMLAttributes } from 'astro/types';
import X from '@lucide/astro/icons/x';

export type ModalVariant = 'dialog' | 'sheet';

interface Props extends Omit<HTMLAttributes<'dialog'>, 'id'> {
  /** Unique id — trigger buttons reference it via `data-modal-open={id}`. */
  id: string;
  variant?: ModalVariant;
}

const { id, variant = 'dialog', class: className, ...rest }: Props = Astro.props;
const titleId = `${id}-title`;

const dialogClasses: Record<ModalVariant, string> = {
  // `fixed` + `inset-0` + `m-auto`: el reset global de Tailwind pone
  // `margin: 0` en todo, lo que rompe el auto-centrado nativo de
  // <dialog> (que depende de `margin: auto`) — sin esto, el modal queda
  // pegado arriba de la pantalla en vez de centrado.
  dialog: 'inset-0 m-auto w-[calc(100%-2rem)]',
  sheet: 'inset-x-0 top-auto bottom-0 mx-auto mb-0 w-full',
};

// Estado inicial (cerrado) — el script de abajo usa los mismos pares.
const panelClasses: Record<ModalVariant, string> = {
  dialog: 'scale-95 rounded-lg p-6',
  sheet: 'translate-y-full rounded-t-lg p-6 pb-[max(1.5rem,env(safe-area-inset-bottom))]',
};
---

<dialog
  id={id}
  data-modal
  data-modal-variant={variant}
  aria-labelledby={titleId}
  class:list={[
    'fixed max-h-[85dvh] max-w-lg border-0 bg-transparent p-0 backdrop:bg-gray-900/60 backdrop:backdrop-blur-sm',
    dialogClasses[variant],
    className,
  ]}
  {...rest}
>
  <div
    data-modal-panel
    class:list={[
      'bg-surface ease-standard flex max-h-[85dvh] flex-col gap-6 overflow-y-auto opacity-0 shadow-xl transition-[transform,opacity] duration-200',
      panelClasses[variant],
    ]}
  >
    <div class="flex items-start justify-between gap-4">
      <h2 id={titleId} class="text-h4 text-text font-bold">
        <slot name="title" />
      </h2>
      <button
        type="button"
        data-modal-close
        aria-label="Cerrar"
        class="text-text-secondary ease-standard hover:bg-surface-alt inline-flex size-8 shrink-0 items-center justify-center rounded-full transition-colors duration-150"
      >
        <X class="size-5" aria-hidden="true" />
      </button>
    </div>

    <div class="text-body text-text-secondary">
      <slot />
    </div>

    <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
      <slot name="actions" />
    </div>
  </div>
</dialog>

<script>
  import { createDialogController } from '@/lib/dialogController';

  document.querySelectorAll<HTMLDialogElement>('[data-modal]').forEach((dialog) => {
    const panel = dialog.querySelector<HTMLElement>('[data-modal-panel]');
    if (!panel) return;

    const isSheet = dialog.dataset.modalVariant === 'sheet';
    const modal = createDialogController({
      dialog,
      panel,
      openClasses: [isSheet ? 'translate-y-0' : 'scale-100', 'opacity-100'],
      closedClasses: [isSheet ? 'translate-y-full' : 'scale-95', 'opacity-0'],
    });

    document
      .querySelectorAll<HTMLElement>(`[data-modal-open="${dialog.id}"]`)
      .forEach((trigger) => trigger.addEventListener('click', modal.open));

    dialog
      .querySelectorAll<HTMLElement>('[data-modal-close]')
      .forEach((closeButton) => closeButton.addEventListener('click', modal.close));
  });
</script>
