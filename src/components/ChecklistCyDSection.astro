---
/**
 * Home. Mini-sección de una sola pieza (no colección/CMS: un único
 * recurso puntual) para destacar la descarga del checklist de
 * Crecimiento y Desarrollo — mismo criterio de contenido fijo en el
 * componente que AgendaSaleSection.astro.
 */
import Section from '@/components/Section.astro';
import Container from '@/components/Container.astro';
import Button from '@/components/Button.astro';
import ClipboardCheck from '@lucide/astro/icons/clipboard-check';
import Download from '@lucide/astro/icons/download';

const CHECKLIST_HREF =
  'https://drive.google.com/uc?export=download&id=1NLaftdQ2RpbVmG3yhoFrSWbfoWoiXwhh';
---

<Section spacing="sm">
  <Container>
    <div
      data-reveal
      class="border-secondary/20 bg-secondary/5 flex flex-col items-center gap-6 rounded-md border p-6 text-center sm:flex-row sm:text-left md:p-8"
    >
      <div
        class="bg-secondary/10 text-secondary-strong inline-flex size-14 shrink-0 items-center justify-center rounded-full"
      >
        <ClipboardCheck class="size-7" aria-hidden="true" />
      </div>
      <div class="flex flex-1 flex-col gap-1">
        <h2 class="text-h4 text-text font-bold">Checklist de Crecimiento y Desarrollo</h2>
        <p class="text-body text-text-secondary">
          Todos los temas del programa organizados para que sepas qué te falta repasar.
        </p>
      </div>
      <Button href={CHECKLIST_HREF} target="_blank" trackId="descarga:checklist-cyd" class="shrink-0">
        <Download slot="icon-start" class="size-4" />
        Descargar
      </Button>
    </div>
  </Container>
</Section>
